+// Sora: scales the tab under the Glance, as Zen scales its browser container.
+// The tab's page is an aura window hosted by the NativeViewHost of its
+// ContentsWebView, so a transform on that window shrinks the page without a
+// relayout. NativeViewHostAura::ShowWidget() sets the window's transform on
+// every layout of the host, so the scale goes back on after each change.
+#if defined(USE_AURA)
+class GlanceController::BackgroundScaler : public aura::WindowObserver {
+ public:
+  explicit BackgroundScaler(content::WebContents* contents)
+      : window_(contents->GetNativeView()) {
+    if (window_) {
+      base_transform_ = window_->transform();
+      observation_.Observe(window_.get());
+    }
+  }
+  BackgroundScaler(const BackgroundScaler&) = delete;
+  BackgroundScaler& operator=(const BackgroundScaler&) = delete;
+  ~BackgroundScaler() override {
+    if (window_ && window_->transform() != base_transform_) {
+      base::AutoReset<bool> applying(&applying_, true);
+      window_->SetTransform(base_transform_);
+    }
+  }
+
+  float scale() const { return scale_; }
+  void SetScale(float scale) {
+    scale_ = scale;
+    Apply();
+  }
+
+  // aura::WindowObserver:
+  void OnWindowTransformed(aura::Window* window,
+                           ui::PropertyChangeReason reason) override {
+    if (applying_) {
+      return;
+    }
+    base_transform_ = window->transform();
+    ApplySoon();
+  }
+  void OnWindowBoundsChanged(aura::Window* window,
+                             const gfx::Rect& old_bounds,
+                             const gfx::Rect& new_bounds,
+                             ui::PropertyChangeReason reason) override {
+    ApplySoon();
+  }
+  void OnWindowDestroying(aura::Window* window) override {
+    observation_.Reset();
+    window_ = nullptr;
+  }
+
+ private:
+  // Not from inside the window's own notifications.
+  void ApplySoon() {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&BackgroundScaler::Apply,
+                                  weak_factory_.GetWeakPtr()));
+  }
+
+  void Apply() {
+    if (!window_) {
+      return;
+    }
+    gfx::Transform transform = base_transform_;
+    transform.PreConcat(gfx::TransformAboutPivot(
+        gfx::RectF(gfx::SizeF(window_->bounds().size())).CenterPoint(),
+        gfx::Transform::MakeScale(scale_)));
+    if (window_->transform() != transform) {
+      base::AutoReset<bool> applying(&applying_, true);
+      window_->SetTransform(transform);
+    }
+  }
+
+  raw_ptr<aura::Window> window_;
+  gfx::Transform base_transform_;
+  float scale_ = 1.0f;
+  bool applying_ = false;
+  base::ScopedObservation<aura::Window, aura::WindowObserver> observation_{
+      this};
+  base::WeakPtrFactory<BackgroundScaler> weak_factory_{this};
+};
+#else
+// Sora: other platforms keep the tab behind at its size, under the veil.
+class GlanceController::BackgroundScaler {
+ public:
+  explicit BackgroundScaler(content::WebContents* contents) {}
+  float scale() const { return 1.0f; }
+  void SetScale(float scale) {}
+};
