+        static_cast<float>(std::clamp(progress, 0.0, 1.0)));
+    background_scaler_->SetScale(
+        gfx::Tween::FloatValueBetween(progress, 1.0f, kBackgroundScale));
+    widget_->GetLayer()->SetOpacity(static_cast<float>(
+        gfx::Tween::CalculateValue(gfx::Tween::EASE_IN_OUT,
+                                   Phase(elapsed, kPageFadeInDuration))));
