+<?xml version="1.0" encoding="utf-8"?>
+<!-- Sora Browser strings. -->
+<grit-part>
+  <message name="IDS_SORA_WORKSPACE_DEFAULT_NAME" desc="Name of a new workspace, a set of tabs in the sidebar.">
+    Space
+  </message>
+  <message name="IDS_SORA_WORKSPACE_NEW" desc="Tooltip of the button that creates a workspace.">
+    New space
+  </message>
+  <message name="IDS_SORA_COMPACT_MODE" desc="Name of the toolbar button that turns compact mode (sidebar hidden until hovered) on and off.">
+    Compact mode
+  </message>
+  <message name="IDS_SORA_GLANCE_OPEN_LINK" desc="Context menu item that opens the link in Glance, a preview card over the current page.">
+    Open link in &amp;Glance
+  </message>
+  <message name="IDS_SORA_GLANCE_CONFIRM_CLOSE" desc="Shown next to Glance's close button after Esc, asking to press Esc again to close.">
+    Confirm
+  </message>
+</grit-part>
