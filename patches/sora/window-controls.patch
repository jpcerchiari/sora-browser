+
+bool BrowserFrameViewWin::ShouldSoraAutoHideWindowControls() const {
+  // Only with the toolbar in the sidebar does nothing else sit above the
+  // contents card; Zen keeps its controls in the toolbar otherwise.
+  return !browser_widget()->IsFullscreen() &&
+         !GetBrowserView()->IsWindowControlsOverlayEnabled() &&
+         GetBrowserView()->IsSoraToolbarInSidebar();
+}
+
+bool BrowserFrameViewWin::AreSoraWindowControlsInteractive() const {
+  return !ShouldSoraAutoHideWindowControls() ||
+         sora_window_controls_reveal_.GetCurrentValue() > 0.0;
+}
+
+int BrowserFrameViewWin::GetSoraWindowControlsStripHeight() const {
+  return gfx::Tween::IntValueBetween(
+      sora_window_controls_reveal_.GetCurrentValue(),
+      kSoraWindowControlsRestHeight, kSoraWindowControlsRevealedHeight);
+}
+
+void BrowserFrameViewWin::UpdateSoraWindowControls() {
+  const bool auto_hide = ShouldSoraAutoHideWindowControls();
+  if (auto_hide) {
+    if (!sora_mouse_monitor_ && GetWidget()) {
+      sora_mouse_monitor_ = views::EventMonitor::CreateWindowMonitor(
+          &sora_mouse_observer_, GetWidget()->GetNativeWindow(),
+          {ui::EventType::kMouseMoved, ui::EventType::kMouseDragged,
+           ui::EventType::kMouseEntered, ui::EventType::kMouseExited});
+    }
+    // The buttons fade, so they need a layer; it also keeps them above the
+    // contents card, which slides under them.
+    if (!caption_button_container_->layer()) {
+      caption_button_container_->SetPaintToLayer();
+      caption_button_container_->layer()->SetFillsBoundsOpaquely(false);
+    }
+  } else {
+    sora_mouse_monitor_.reset();
+    sora_window_controls_delay_.Stop();
+    sora_window_controls_hovered_ = false;
+    sora_window_controls_reveal_.Reset(0.0);
+    // Window controls overlay keeps its own layer.
+    if (caption_button_container_->layer() &&
+        !GetBrowserView()->IsWindowControlsOverlayEnabled()) {
+      caption_button_container_->DestroyLayer();
+    }
+  }
+
+  const bool interactive = AreSoraWindowControlsInteractive();
+  if (!interactive &&
+      caption_button_container_->GetCanProcessEventsWithinSubtree()) {
+    // Don't leave a button hovered or pressed behind while hidden.
+    caption_button_container_->ResetWindowControls();
+  }
+  caption_button_container_->SetCanProcessEventsWithinSubtree(interactive);
+  if (ui::Layer* const layer = caption_button_container_->layer()) {
+    layer->SetOpacity(
+        auto_hide
+            ? static_cast<float>(sora_window_controls_reveal_.GetCurrentValue())
+            : 1.0f);
+  }
+}
+
+void BrowserFrameViewWin::OnSoraMouseEvent() {
+  // The cursor position works for every event, including the exit from the
+  // window: a strip only covers the inside of the window.
+  gfx::Point point = display::Screen::Get()->GetCursorScreenPoint();
+  views::View::ConvertPointFromScreen(GetBrowserView(), &point);
+  const bool hovered =
+      GetBrowserView()->GetSoraWindowControlsStrip().Contains(point);
+  if (hovered == sora_window_controls_hovered_) {
+    return;
+  }
+  sora_window_controls_hovered_ = hovered;
+  sora_window_controls_delay_.Start(
+      FROM_HERE, kSoraWindowControlsDelay,
+      base::BindOnce(&BrowserFrameViewWin::AnimateSoraWindowControls,
+                     base::Unretained(this)));
+}
+
+void BrowserFrameViewWin::AnimateSoraWindowControls() {
+  if (sora_window_controls_hovered_) {
+    sora_window_controls_reveal_.Show();
+  } else {
+    sora_window_controls_reveal_.Hide();
+  }
+}
+
+void BrowserFrameViewWin::AnimationProgressed(
+    const gfx::Animation* animation) {
+  UpdateSoraWindowControls();
+  // The browser layout moves the top of the contents card with the strip.
+  GetBrowserView()->InvalidateLayout();
+}
+
+void BrowserFrameViewWin::AnimationEnded(const gfx::Animation* animation) {
+  AnimationProgressed(animation);
+}
+
+void BrowserFrameViewWin::SoraMouseObserver::OnEvent(const ui::Event& event) {
+  frame_view_->OnSoraMouseEvent();
 }
 
