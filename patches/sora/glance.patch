+
+class BrowserWindowInterface;
+
+namespace blink {
+class WebMouseEvent;
+}  // namespace blink
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+// Sora: Glance, Zen's link preview (sora/zen-spec.md, section 10).
+//
+// Alt + click on a link opens it in a floating card over the tab it came from:
+// 80% of the width, full height, with the tab behind it faded into the frame
+// color. A column of round buttons next to the card closes it, opens it as a
+// tab, or opens it in split view next to the tab. Esc, a click outside the
+// card, or closing the tab also close it.
+//
+// The preview is a WebContents of its own, outside the tab strip, shown in a
+// child widget over the tab's contents container. Opening it as a tab hands
+// that WebContents to chrome::Navigate(), which adopts it (tab helpers and
+// all) like any other new tab, so the page is not loaded twice.
+//
+// One per browser window, owned by BrowserWebContentsDelegate, which feeds it
+// the hovered link (UpdateTargetURL) and the mouse events (PreHandleMouseEvent)
+// of every tab.
+class GlanceController : public content::WebContentsDelegate,
+                         public TabStripModelObserver,
+                         public views::ViewObserver,
+                         public views::WidgetObserver {
+ public:
+  explicit GlanceController(BrowserWindowInterface& browser);
+  GlanceController(const GlanceController&) = delete;
+  GlanceController& operator=(const GlanceController&) = delete;
+  ~GlanceController() override;
+
+  // Whether `browser` gets a Glance at all: normal tabbed windows only.
+  static bool IsSupported(const BrowserWindowInterface& browser);
+
+  // Called by BrowserWebContentsDelegate for every tab of the window.
+  void OnTargetURLChanged(content::WebContents* source, const GURL& url);
+  // Returns true when the event starts or finishes a Glance click and must not
+  // reach the page.
+  bool OnMouseEvent(content::WebContents* source,
+                    const blink::WebMouseEvent& event);
+
+  // Called from the overlay. They post the work, since the overlay is
+  // destroyed by it.
+  void RequestClose();
+  void RequestOpenAsTab(bool split);
+
+  // content::WebContentsDelegate (for the previewed page):
+  content::WebContents* OpenURLFromTab(
+      content::WebContents* source,
+      const content::OpenURLParams& params,
+      base::OnceCallback<void(content::NavigationHandle&)>
+          navigation_handle_callback) override;
+  content::WebContents* AddNewContents(
+      content::WebContents* source,
+      std::unique_ptr<content::WebContents> new_contents,
+      const GURL& target_url,
+      WindowOpenDisposition disposition,
+      const blink::mojom::WindowFeatures& window_features,
+      bool user_gesture,
+      bool* was_blocked) override;
+  void CloseContents(content::WebContents* source) override;
+  bool HandleKeyboardEvent(content::WebContents* source,
+                           const input::NativeWebKeyboardEvent& event) override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+
+  // views::ViewObserver:
+  void OnViewBoundsChanged(views::View* observed_view) override;
+  void OnViewIsDeleting(views::View* observed_view) override;
+
+  // views::WidgetObserver (the browser window):
+  void OnWidgetDestroying(views::Widget* widget) override;
+
+ private:
+  void Open(base::WeakPtr<content::WebContents> parent, const GURL& url);
+  void OpenAsTab(bool split);
+  void Close();
+  // Shows, hides, places or closes the Glance after its tab changed.
+  void Update();
+  // Destroys the overlay and the previewed page right away.
+  void Destroy();
+  views::View* GetParentContainer();
+
+  const raw_ref<BrowserWindowInterface> browser_;
+
+  // Link under the mouse, as reported to the status bubble.
+  base::WeakPtr<content::WebContents> hovered_contents_;
+  GURL hovered_url_;
+
+  // Alt + mouse down on a link, waiting for its mouse up.
+  base::WeakPtr<content::WebContents> pressed_contents_;
+  GURL pressed_url_;
+  gfx::PointF pressed_point_;
+
+  // The open Glance.
+  base::WeakPtr<content::WebContents> parent_;
+  std::unique_ptr<content::WebContents> contents_;
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<views::View> container_ = nullptr;
+  // Hidden and about to be destroyed.
+  bool closing_ = false;
+
+  base::ScopedMultiSourceObservation<views::View, views::ViewObserver>
+      view_observations_{this};
+  base::ScopedObservation<views::Widget, views::WidgetObserver>
+      browser_widget_observation_{this};
+
+  base::WeakPtrFactory<GlanceController> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_GLANCE_GLANCE_CONTROLLER_H_
