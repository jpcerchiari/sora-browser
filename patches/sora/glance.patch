+}  // namespace
+
+GlanceController::GlanceController(BrowserWindowInterface& browser)
+    : browser_(browser) {
+  browser_->GetTabStripModel()->AddObserver(this);
+}
+
+GlanceController::~GlanceController() {
+  Destroy();
+}
+
+// static
+bool GlanceController::IsSupported(const BrowserWindowInterface& browser) {
+  return browser.GetType() == BrowserWindowInterface::TYPE_NORMAL;
+}
+
+void GlanceController::OnTargetURLChanged(content::WebContents* source,
+                                          const GURL& url) {
+  hovered_contents_ =
+      source ? source->GetWeakPtr() : base::WeakPtr<content::WebContents>();
+  hovered_url_ = url;
+}
+
+bool GlanceController::OnMouseEvent(content::WebContents* source,
+                                    const blink::WebMouseEvent& event) {
+  switch (event.GetType()) {
+    case blink::WebInputEvent::Type::kMouseDown: {
+      pressed_contents_ = nullptr;
+      // Alt and no other modifier, left button, on an http(s) link of a tab.
+      if ((event.GetModifiers() & kModifierMask) !=
+              blink::WebInputEvent::kAltKey ||
+          event.button != blink::WebPointerProperties::Button::kLeft) {
+        return false;
+      }
+      if (contents_ || !source || source != hovered_contents_.get() ||
+          !hovered_url_.SchemeIsHTTPOrHTTPS() ||
+          browser_->GetTabStripModel()->GetIndexOfWebContents(source) ==
+              TabStripModel::kNoTab) {
+        return false;
+      }
+      pressed_contents_ = source->GetWeakPtr();
+      pressed_url_ = hovered_url_;
+      pressed_point_ = event.PositionInScreen();
+      return true;
+    }
+    case blink::WebInputEvent::Type::kMouseMove:
+      if (!pressed_contents_ || source != pressed_contents_.get()) {
+        return false;
+      }
+      if (!(event.GetModifiers() & blink::WebInputEvent::kLeftButtonDown)) {
+        pressed_contents_ = nullptr;
+        return false;
+      }
+      return true;
+    case blink::WebInputEvent::Type::kMouseUp: {
+      if (!pressed_contents_ || source != pressed_contents_.get()) {
+        return false;
+      }
+      pressed_contents_ = nullptr;
+      const gfx::Vector2dF moved = event.PositionInScreen() - pressed_point_;
+      if (std::abs(moved.x()) <= kDragThreshold &&
+          std::abs(moved.y()) <= kDragThreshold) {
+        // Not from inside the input dispatch of `source`.
+        base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE,
+            base::BindOnce(&GlanceController::Open, weak_factory_.GetWeakPtr(),
+                           source->GetWeakPtr(), pressed_url_));
+      }
+      return true;
+    }
+    default:
+      return false;
+  }
+}
+
+void GlanceController::RequestClose() {
+  closing_ = true;
+  if (widget_) {
+    widget_->Hide();
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&GlanceController::Close, weak_factory_.GetWeakPtr()));
+}
+
+void GlanceController::RequestOpenAsTab(bool split) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&GlanceController::OpenAsTab,
+                                weak_factory_.GetWeakPtr(), split));
+}
+
+content::WebContents* GlanceController::OpenURLFromTab(
+    content::WebContents* source,
+    const content::OpenURLParams& params,
+    base::OnceCallback<void(content::NavigationHandle&)>
+        navigation_handle_callback) {
+  if (params.disposition == WindowOpenDisposition::CURRENT_TAB) {
+    base::WeakPtr<content::NavigationHandle> handle =
+        source->GetController().LoadURLWithParams(
+            content::NavigationController::LoadURLParams(params));
+    if (navigation_handle_callback && handle) {
+      std::move(navigation_handle_callback).Run(*handle);
+    }
+    return source;
+  }
+  // New tabs and windows open from the tab under the Glance.
+  content::WebContents* parent = parent_.get();
+  if (!parent || !parent->GetDelegate()) {
+    return nullptr;
+  }
+  return parent->GetDelegate()->OpenURLFromTab(
+      parent, params, std::move(navigation_handle_callback));
+}
+
+content::WebContents* GlanceController::AddNewContents(
+    content::WebContents* source,
+    std::unique_ptr<content::WebContents> new_contents,
+    const GURL& target_url,
+    WindowOpenDisposition disposition,
+    const blink::mojom::WindowFeatures& window_features,
+    bool user_gesture,
+    bool* was_blocked) {
+  content::WebContents* parent = parent_.get();
+  if (!parent || !parent->GetDelegate()) {
+    return nullptr;
+  }
+  return parent->GetDelegate()->AddNewContents(
+      parent, std::move(new_contents), target_url, disposition,
+      window_features, user_gesture, was_blocked);
+}
+
+void GlanceController::CloseContents(content::WebContents* source) {
+  RequestClose();
+}
+
+bool GlanceController::HandleKeyboardEvent(
+    content::WebContents* source,
+    const input::NativeWebKeyboardEvent& event) {
+  if (event.GetType() == blink::WebInputEvent::Type::kRawKeyDown) {
+    const int modifiers = event.GetModifiers() & kModifierMask;
+    // Esc the page did not use closes; Ctrl+O opens as a tab, as in Zen.
+    if (event.windows_key_code == ui::VKEY_ESCAPE && !modifiers) {
+      RequestClose();
+      return true;
+    }
+    if (event.windows_key_code == ui::VKEY_O &&
+        modifiers == blink::WebInputEvent::kControlKey) {
+      RequestOpenAsTab(/*split=*/false);
+      return true;
+    }
+  }
+  // Other shortcuts work as in the tab under the Glance.
+  content::WebContents* parent = parent_.get();
+  return parent && parent->GetDelegate() &&
+         parent->GetDelegate()->HandleKeyboardEvent(source, event);
+}
+
+void GlanceController::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (!contents_) {
+    return;
+  }
+  // After BrowserView has moved the contents around.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&GlanceController::Update, weak_factory_.GetWeakPtr()));
+}
+
+void GlanceController::OnViewBoundsChanged(views::View* observed_view) {
+  Update();
+}
+
+void GlanceController::OnViewIsDeleting(views::View* observed_view) {
+  view_observations_.RemoveAllObservations();
+  container_ = nullptr;
+  RequestClose();
+}
+
+void GlanceController::OnWidgetDestroying(views::Widget* widget) {
+  browser_widget_observation_.Reset();
+  Destroy();
+}
+
+void GlanceController::Open(base::WeakPtr<content::WebContents> parent,
+                            const GURL& url) {
+  if (!parent || contents_) {
+    return;
+  }
+  BrowserView* browser_view =
+      BrowserView::GetBrowserViewForBrowser(&*browser_);
+  if (!browser_view || !browser_view->GetWidget() ||
+      !browser_view->GetContentsContainerViewFor(parent.get())) {
+    return;
+  }
+  if (!browser_widget_observation_.IsObserving()) {
+    browser_widget_observation_.Observe(browser_view->GetWidget());
+  }
+  parent_ = parent;
+
+  contents_ = content::WebContents::Create(
+      content::WebContents::CreateParams(parent->GetBrowserContext()));
+  contents_->SetDelegate(this);
+  content::NavigationController::LoadURLParams load_params(url);
+  load_params.transition_type = ui::PAGE_TRANSITION_LINK;
+  load_params.referrer = content::Referrer::SanitizeForRequest(
+      url, content::Referrer(
+               parent->GetLastCommittedURL(),
+               network::mojom::ReferrerPolicy::kStrictOriginWhenCrossOrigin));
+  load_params.initiator_origin =
+      parent->GetPrimaryMainFrame()->GetLastCommittedOrigin();
+  contents_->GetController().LoadURLWithParams(load_params);
+
+  // A child of the browser window, like the find bar.
+  auto widget = std::make_unique<ThemeCopyingWidget>(browser_view->GetWidget());
+  views::Widget::InitParams params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_CONTROL);
+  params.name = "SoraGlance";
+  params.parent = browser_view->GetWidget()->GetNativeView();
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  params.activatable = views::Widget::InitParams::Activatable::kNo;
+  widget->Init(std::move(params));
+  GlanceView* view = widget->SetContentsView(
+      std::make_unique<GlanceView>(this, contents_.get()));
+  widget_ = std::move(widget);
+
+  Update();
+  if (!widget_ || !widget_->IsVisible()) {
+    return;
+  }
+  view->web_view()->RequestFocus();
+  if (gfx::Animation::ShouldRenderRichAnimation()) {
+    ui::Layer* layer = widget_->GetLayer();
+    layer->SetOpacity(0.0f);
+    ui::ScopedLayerAnimationSettings settings(layer->GetAnimator());
+    settings.SetTransitionDuration(kOpenDuration);
+    settings.SetTweenType(gfx::Tween::EASE_OUT);
+    layer->SetOpacity(1.0f);
+  }
+}
+
+void GlanceController::OpenAsTab(bool split) {
+  content::WebContents* parent = parent_.get();
+  if (!contents_ || !parent) {
+    return;
+  }
+  std::unique_ptr<content::WebContents> contents = std::move(contents_);
+  Destroy();
+  contents->SetDelegate(nullptr);
+  const GURL url = contents->GetVisibleURL();
+  // Inserted next to the tab, which adopts it with all its tab helpers. For
+  // split, Navigate() pairs it with the active tab, which is `parent`; if
+  // `parent` is already split it just opens as a tab.
+  chrome::AddWebContents(&*browser_, parent, std::move(contents), url,
+                         split ? WindowOpenDisposition::NEW_SPLIT_VIEW
+                               : WindowOpenDisposition::NEW_FOREGROUND_TAB,
+                         blink::mojom::WindowFeatures());
+}
+
+void GlanceController::Close() {
+  base::WeakPtr<content::WebContents> parent = parent_;
+  Destroy();
+  if (parent &&
+      browser_->GetTabStripModel()->GetActiveWebContents() == parent.get()) {
+    parent->Focus();
+  }
+}
+
+void GlanceController::Update() {
+  if (!contents_ || !widget_ || closing_) {
+    return;
+  }
+  if (!parent_ || browser_->GetTabStripModel()->GetIndexOfWebContents(
+                      parent_.get()) == TabStripModel::kNoTab) {
+    Destroy();
+    return;
+  }
+
+  // Follow the tab's contents container and every view above it, so the
+  // Glance moves with any layout change (sidebar width, split view, resize).
+  views::View* container = GetParentContainer();
+  if (container != container_) {
+    view_observations_.RemoveAllObservations();
+    container_ = container;
+    for (views::View* view = container; view; view = view->parent()) {
+      view_observations_.AddObservation(view);
+    }
+  }
+
+  // Hidden while another tab is shown; back when its tab is.
+  if (!container_ || !container_->IsDrawn()) {
+    widget_->Hide();
+    return;
+  }
+  widget_->SetBounds(
+      container_->ConvertRectToWidget(container_->GetLocalBounds()));
+  if (!widget_->IsVisible()) {
+    widget_->Show();
+  }
+  // Above the tab's web contents, which are attached again on tab switch.
+  widget_->StackAtTop();
+}
+
+void GlanceController::Destroy() {
+  view_observations_.RemoveAllObservations();
+  container_ = nullptr;
+  // The overlay first, since it shows `contents_`.
+  widget_.reset();
+  contents_.reset();
+  parent_ = nullptr;
+  closing_ = false;
+}
+
+views::View* GlanceController::GetParentContainer() {
+  BrowserView* browser_view =
+      BrowserView::GetBrowserViewForBrowser(&*browser_);
+  if (!browser_view || !parent_) {
+    return nullptr;
+  }
+  return browser_view->GetContentsContainerViewFor(parent_.get());
+}
