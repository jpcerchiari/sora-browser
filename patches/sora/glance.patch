+
+// Values from sora/zen-spec.md, section 10.
+// The card takes 80% of the tab's width and all of its height.
+constexpr float kCardWidthFraction = 0.8f;
+// Same radius as the page card (MultiContentsView with floating-contents).
+constexpr float kCardRadius = 5.0f;
+// --zen-big-shadow: rgba(0, 0, 0, 0.24) 0 3px 8px.
+constexpr gfx::Vector2d kCardShadowOffset(0, 3);
+constexpr double kCardShadowBlur = 8;
+constexpr SkAlpha kCardShadowAlpha = 0x3D;
+// The tab behind fades to opacity 0.3 over the window background, which is
+// the frame color drawn at 70% on top of it.
+constexpr SkAlpha kBackdropAlpha = 0xB3;
+// Buttons: 34px circles with an 8px padding, in a column 15px from the top,
+// with 12px of padding and 12px between them.
+constexpr int kButtonSize = 34;
+constexpr int kButtonPadding = 8;
+constexpr int kButtonsTop = 15;
+constexpr int kButtonsSpacing = 12;
+// A click that moved more than this is a text selection, not a Glance.
+constexpr float kDragThreshold = 4.0f;
+// zen.glance.animation-duration.
+constexpr base::TimeDelta kOpenDuration = base::Milliseconds(350);
+
+constexpr int kModifierMask =
+    blink::WebInputEvent::kShiftKey | blink::WebInputEvent::kControlKey |
+    blink::WebInputEvent::kAltKey | blink::WebInputEvent::kMetaKey;
+
+bool IsDarkFrame(const ui::ColorProvider* color_provider) {
+  return color_utils::IsDark(color_provider->GetColor(ui::kColorFrameActive));
+}
+
+// Round button of the Glance column. The icon is the accent color over a
+// near-black (light theme) or near-white (dark theme) circle.
+class GlanceButton : public views::ImageButton {
+  METADATA_HEADER(GlanceButton, views::ImageButton)
+
+ public:
+  GlanceButton(PressedCallback callback,
+               const gfx::VectorIcon& icon,
+               const std::u16string& tooltip)
+      : views::ImageButton(std::move(callback)) {
+    SetImageModel(views::Button::STATE_NORMAL,
+                  ui::ImageModel::FromVectorIcon(
+                      icon, ui::kColorSysPrimary,
+                      kButtonSize - 2 * kButtonPadding));
+    SetImageHorizontalAlignment(ALIGN_CENTER);
+    SetImageVerticalAlignment(ALIGN_MIDDLE);
+    SetTooltipText(tooltip);
+    views::InstallCircleHighlightPathGenerator(this);
+  }
+
+  // views::ImageButton:
+  void OnPaintBackground(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* color_provider = GetColorProvider();
+    const bool dark = IsDarkFrame(color_provider);
+    SkColor color;
+    if (GetState() == STATE_HOVERED || GetState() == STATE_PRESSED) {
+      color = dark ? SkColorSetRGB(0xCC, 0xCC, 0xCC)
+                   : SkColorSetRGB(0x29, 0x29, 0x29);
+    } else {
+      color = color_utils::AlphaBlend(
+          color_provider->GetColor(ui::kColorSysPrimary),
+          dark ? SkColorSetRGB(0xE2, 0xE2, 0xE2)
+               : SkColorSetRGB(0x1C, 0x1C, 0x1C),
+          0.04f);
+    }
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(color);
+    const gfx::RectF bounds(GetLocalBounds());
+    canvas->DrawCircle(bounds.CenterPoint(), bounds.width() / 2, flags);
+  }
+};
+
+BEGIN_METADATA(GlanceButton)
+END_METADATA
+
+// Contents of the Glance widget, which covers the whole tab: the faded tab,
+// the card with the previewed page, and the buttons.
+class GlanceView : public views::View {
+  METADATA_HEADER(GlanceView, views::View)
+
+ public:
+  GlanceView(GlanceController* controller, content::WebContents* contents)
+      : controller_(controller) {
+    web_view_ = AddChildView(
+        std::make_unique<views::WebView>(contents->GetBrowserContext()));
+    web_view_->SetWebContents(contents);
+    web_view_->holder()->SetNativeViewCornerRadii(
+        gfx::RoundedCornersF(kCardRadius));
+
+    std::u16string open_as_tab;
+    base::RemoveChars(
+        l10n_util::GetStringUTF16(IDS_CONTENT_CONTEXT_OPENLINKNEWTAB), u"&",
+        &open_as_tab);
+    buttons_.push_back(AddChildView(std::make_unique<GlanceButton>(
+        base::BindRepeating(&GlanceController::RequestClose,
+                            base::Unretained(controller)),
+        kCloseIcon, l10n_util::GetStringUTF16(IDS_APP_CLOSE))));
+    buttons_.push_back(AddChildView(std::make_unique<GlanceButton>(
+        base::BindRepeating(&GlanceController::RequestOpenAsTab,
+                            base::Unretained(controller), /*split=*/false),
+        kFullscreenIcon, open_as_tab)));
+    buttons_.push_back(AddChildView(std::make_unique<GlanceButton>(
+        base::BindRepeating(&GlanceController::RequestOpenAsTab,
+                            base::Unretained(controller), /*split=*/true),
+        kSplitSceneIcon,
+        l10n_util::GetStringUTF16(IDS_CONTENT_CONTEXT_OPENLINKSPLITVIEW))));
+  }
+
+  views::WebView* web_view() { return web_view_; }
+
+  // views::View:
+  void OnBoundsChanged(const gfx::Rect& previous_bounds) override {
+    const gfx::Rect bounds = GetLocalBounds();
+    card_ = bounds;
+    card_.set_width(base::ClampRound(bounds.width() * kCardWidthFraction));
+    card_.set_x(bounds.x() + (bounds.width() - card_.width()) / 2);
+    web_view_->SetBoundsRect(card_);
+
+    // Right of the card, kept inside the tab when the tab is narrow.
+    const int x = std::min(card_.right() + kButtonsSpacing,
+                           bounds.right() - kButtonSize);
+    int y = card_.y() + kButtonsTop + kButtonsSpacing;
+    for (views::View* button : buttons_) {
+      button->SetBoundsRect(gfx::Rect(x, y, kButtonSize, kButtonSize));
+      y += kButtonSize + kButtonsSpacing;
+    }
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* color_provider = GetColorProvider();
+    canvas->DrawColor(SkColorSetA(
+        color_provider->GetColor(ui::kColorFrameActive), kBackdropAlpha));
+
+    // The page background under the card, which also casts its shadow.
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(IsDarkFrame(color_provider) ? SkColorSetRGB(0x10, 0x10, 0x10)
+                                               : SK_ColorWHITE);
+    flags.setLooper(gfx::CreateShadowDrawLooper({gfx::ShadowValue(
+        kCardShadowOffset, kCardShadowBlur,
+        SkColorSetA(SK_ColorBLACK, kCardShadowAlpha))}));
+    canvas->DrawRoundRect(gfx::RectF(card_), kCardRadius, flags);
+  }
+
+  // A click on the faded tab closes the Glance.
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    return !card_.Contains(event.location());
+  }
+
+  void OnMouseReleased(const ui::MouseEvent& event) override {
+    if (!card_.Contains(event.location()) && HitTestPoint(event.location())) {
+      controller_->RequestClose();
+    }
+  }
+
+ private:
+  const raw_ptr<GlanceController> controller_;
+  raw_ptr<views::WebView> web_view_ = nullptr;
+  std::vector<raw_ptr<views::View>> buttons_;
+  gfx::Rect card_;
+};
+
+BEGIN_METADATA(GlanceView)
+END_METADATA
