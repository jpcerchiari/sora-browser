+
+void VerticalTabStripRegionView::OnSoraCompactModeChanged() {
+  // Start every switch hidden; the next hover reveals the panel.
+  mouse_exit_timer_.Stop();
+  sora_compact_revealed_ = false;
+  sora_compact_reveal_.Reset(0.0);
+  UpdateExpandOnHoverState();
+  // Moves the strip in or out of the browser layout and shows or hides its
+  // top button row (see IsSoraToolbarInSidebar()).
+  InvalidateLayout();
+}
+
+void VerticalTabStripRegionView::UpdateSoraCompactReveal(
+    std::optional<bool> hovered) {
+  // Same precedence as UpdateExpandOnHoverState(): locks first, then the
+  // window state, then hover and focus.
+  if (force_collapse_lock_count_ > 0) {
+    AnimateSoraCompactReveal(false);
+    return;
+  }
+  if (keep_current_state_lock_count_ > 0) {
+    return;
+  }
+  if (keep_expanded_lock_count_ > 0) {
+    AnimateSoraCompactReveal(true);
+    return;
+  }
+  const views::Widget* const widget = GetWidget();
+  if (!widget) {
+    return;
+  }
+  if (!widget->ShouldPaintAsActive()) {
+    AnimateSoraCompactReveal(false);
+    return;
+  }
+  // A bubble opened from the panel takes activation while the browser keeps
+  // painting as active: leave the panel as it is until the bubble closes.
+  if (!widget->IsActive()) {
+    return;
+  }
+  AnimateSoraCompactReveal(
+      hovered.value_or(IsSoraCompactPanelHovered()) ||
+      (GetFocusManager() && Contains(GetFocusManager()->GetFocusedView())));
+}
+
+void VerticalTabStripRegionView::AnimateSoraCompactReveal(bool show) {
+  if (show == sora_compact_revealed_) {
+    return;
+  }
+  sora_compact_revealed_ = show;
+  sora_compact_reveal_.SetSlideDuration(show ? kSoraCompactShowDuration
+                                             : kSoraCompactHideDuration);
+  sora_compact_reveal_.SetTweenType(show ? kSoraCompactShowTween
+                                         : kSoraCompactHideTween);
+  if (show) {
+    sora_compact_reveal_.Show();
+  } else {
+    sora_compact_reveal_.Hide();
+  }
+  // Re-run Layout() for the resize area, see there.
+  InvalidateLayout();
+}
+
+void VerticalTabStripRegionView::OnSoraCompactExitDelayElapsed() {
+  if (IsSoraCompactPanelHovered()) {
+    mouse_exit_timer_.Start(
+        FROM_HERE, kSoraCompactKeepHoverDelay,
+        base::BindOnce(
+            &VerticalTabStripRegionView::OnSoraCompactExitDelayElapsed,
+            base::Unretained(this)));
+    return;
+  }
+  UpdateExpandOnHoverState(/*hovered=*/false);
+}
+
+bool VerticalTabStripRegionView::IsSoraCompactPanelHovered() const {
+  // Only the part of the panel inside the browser counts: hidden, most of it
+  // lies past the window edge.
+  if (!GetWidget() || !parent()) {
+    return false;
+  }
+  const gfx::Point cursor = display::Screen::Get()->GetCursorScreenPoint();
+  gfx::Point in_panel = cursor;
+  views::View::ConvertPointFromScreen(this, &in_panel);
+  gfx::Point in_parent = cursor;
+  views::View::ConvertPointFromScreen(parent(), &in_parent);
+  return HitTestPoint(in_panel) && parent()->HitTestPoint(in_parent);
+}
