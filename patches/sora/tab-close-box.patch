+// Sora: Zen's close button box (.tab-close-button): 24x24 with an 8px radius,
+// a 10% veil on hover and 20% while pressed.
+constexpr float kSoraCloseBoxSize = 24.0f;
+constexpr float kSoraCloseBoxRadius = 8.0f;
+constexpr float kSoraCloseHoverOpacity = 0.10f;
+constexpr float kSoraClosePressedOpacity = 0.20f;
+
+// Sora: the 24x24 box centred in the button, for the ink drop and focus ring.
+class SoraCloseBoxPathGenerator : public views::HighlightPathGenerator {
+ public:
+  SoraCloseBoxPathGenerator() = default;
+  SoraCloseBoxPathGenerator(const SoraCloseBoxPathGenerator&) = delete;
+  SoraCloseBoxPathGenerator& operator=(const SoraCloseBoxPathGenerator&) =
+      delete;
+
+  // views::HighlightPathGenerator:
+  std::optional<gfx::RRectF> GetRoundRect(const gfx::RectF& rect) override {
+    const float size =
+        std::min({kSoraCloseBoxSize, rect.width(), rect.height()});
+    gfx::RectF box(size, size);
+    box.set_origin(rect.CenterPoint() - gfx::Vector2dF(size / 2, size / 2));
+    return gfx::RRectF(box, kSoraCloseBoxRadius);
+  }
+};
+
