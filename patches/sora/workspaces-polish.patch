+bool SoraWorkspaceIndicator::HandleKeyEvent(views::Textfield* sender,
+                                            const ui::KeyEvent& key_event) {
+  if (key_event.type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+  if (key_event.key_code() == ui::VKEY_RETURN) {
+    EndRename(/*commit=*/true);
+    return true;
+  }
