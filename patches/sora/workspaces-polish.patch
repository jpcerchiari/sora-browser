+bool IsEmojiGrapheme(std::u16string_view grapheme) {
+  size_t i = 0;
+  while (i < grapheme.size()) {
+    UChar32 c;
+    U16_NEXT(grapheme.data(), i, grapheme.size(), c);
+    if (u_hasBinaryProperty(c, UCHAR_EXTENDED_PICTOGRAPHIC) ||
+        u_hasBinaryProperty(c, UCHAR_REGIONAL_INDICATOR)) {
+      return true;
+    }
