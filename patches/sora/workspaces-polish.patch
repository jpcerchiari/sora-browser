+// static
+SoraWorkspacesController::Title SoraWorkspacesController::ParseTitle(
+    std::u16string_view title) {
+  base::i18n::BreakIterator graphemes(
+      title, base::i18n::BreakIterator::BREAK_CHARACTER);
+  if (title.empty() || !graphemes.Init() || !graphemes.Advance()) {
+    return {u"", std::u16string(title)};
+  }
+  const size_t icon_end = graphemes.pos();
+  const std::u16string_view icon = title.substr(0, icon_end);
+  // The icon is the whole title, or is followed by the separator.
+  if (!IsEmojiGrapheme(icon) ||
+      (icon_end < title.size() && title[icon_end] != kSoraIconSeparator)) {
+    return {u"", std::u16string(title)};
+  }
+  std::u16string_view name = title.substr(icon_end);
+  while (!name.empty() && name.front() == kSoraIconSeparator) {
+    name.remove_prefix(1);
+  }
+  return {std::u16string(icon), std::u16string(name)};
+}
