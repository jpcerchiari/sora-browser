+void SelectSoraWorkspace(BrowserWindowInterface* browser, int index) {
+  TabStripModel* const tab_strip_model = browser->GetTabStripModel();
+  TabGroupModel* const group_model = tab_strip_model->group_model();
+  if (!tab_strip_model->SupportsTabGroups() || !group_model ||
+      !base::FeatureList::IsEnabled(features::kTabGroupsFocusing)) {
+    return;
+  }
+  // The workspaces: groups that are not ephemeral (Chromium's "focus tabs"),
+  // ordered by their first tab.
+  std::vector<tab_groups::TabGroupId> workspaces;
+  for (const tab_groups::TabGroupId& group : group_model->ListTabGroups()) {
+    if (!tab_strip_model->IsEphemeralTabGroup(group) &&
+        !group_model->GetTabGroup(group)->IsEmpty()) {
+      workspaces.push_back(group);
+    }
+  }
+  if (index < 0 || static_cast<size_t>(index) >= workspaces.size()) {
+    return;
+  }
+  std::ranges::sort(workspaces, {}, [&](const tab_groups::TabGroupId& id) {
+    return group_model->GetTabGroup(id)->ListTabs().start();
+  });
+  const tab_groups::TabGroupId workspace = workspaces[index];
+  if (tab_strip_model->GetFocusedGroup() == workspace) {
+    return;
+  }
+  // The tab used last in the workspace, as Zen does.
+  tabs::TabInterface* tab_to_select = nullptr;
+  base::TimeTicks last_active;
+  const gfx::Range group_tabs =
+      group_model->GetTabGroup(workspace)->ListTabs();
+  for (size_t i = group_tabs.start(); i < group_tabs.end(); ++i) {
+    tabs::TabInterface* const tab =
+        tab_strip_model->GetTabAtIndex(static_cast<int>(i));
+    const base::TimeTicks active = tab->GetContents()->GetLastActiveTimeTicks();
+    if (!tab_to_select || active > last_active) {
+      tab_to_select = tab;
+      last_active = active;
+    }
+  }
+  // Selecting a tab outside the focused group ends focus mode; entering it
+  // again for the tab's group keeps the tab selected.
+  tab_strip_model->ActivateTab(
+      tab_to_select, TabStripUserGestureDetails(
+                         TabStripUserGestureDetails::GestureType::kKeyboard));
+  if (group_model->ContainsTabGroup(workspace)) {
+    tab_strip_model->EnterFocusMode(workspace);
+  }
+}
