+  renaming_ = true;
+  rename_field_->SetText(controller_->GetDisplayName(*workspace_));
+  rename_field_->GetViewAccessibility().SetName(
+      std::u16string(name_label_->GetText()));
+  name_label_->SetVisible(false);
+  rename_field_->SetVisible(true);
+  rename_field_->RequestFocus();
+  rename_field_->SelectAll(/*reversed=*/false);
+}
+
+void SoraWorkspaceIndicator::EndRename(bool commit) {
+  // Hiding the field or moving the focus blurs it, which calls this again.
+  if (!renaming_) {
+    return;
+  }
+  renaming_ = false;
+  const std::u16string name(
+      base::TrimWhitespace(rename_field_->GetText(), base::TRIM_ALL));
+  if (rename_field_->HasFocus()) {
+    RequestFocus();
+  }
+  rename_field_->SetVisible(false);
+  name_label_->SetVisible(true);
+  // Zen keeps the old name when the new one is empty; Rename() ignores it.
+  if (commit && controller_ && workspace_) {
+    controller_->Rename(*workspace_, name);
+  }
+}
