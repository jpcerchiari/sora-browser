+void VerticalTabStripRegionView::AnimateSoraWorkspaceSwitch(bool forward) {
+  views::View* const strip = tab_strip_view();
+  if (!strip || !strip->IsDrawn() ||
+      !gfx::Animation::ShouldRenderRichAnimation()) {
+    return;
+  }
+  // Ends a slide in progress, restoring the clip.
+  sora_workspace_slide_.Reset(0.0);
+  // The list moves on its own layer, clipped to the content area so it does
+  // not run over the page or the window edge.
+  if (!strip->layer()) {
+    strip->SetPaintToLayer();
+    strip->layer()->SetFillsBoundsOpaquely(false);
+  }
+  sora_content_masked_ = content_area_view_->layer()->GetMasksToBounds();
+  content_area_view_->layer()->SetMasksToBounds(true);
+  // As in Zen, the next workspace comes from the end side (the right in LTR)
+  // and the previous one from the start side.
+  sora_workspace_slide_from_ = forward != base::i18n::IsRTL() ? 1 : -1;
+  sora_workspace_slide_.SetSlideDuration(kSoraWorkspaceSwitchDuration);
+  sora_workspace_slide_.SetTweenType(kSoraWorkspaceSwitchTween);
+  UpdateSoraWorkspaceSlide();
+  sora_workspace_slide_.Show();
+}
+
+void VerticalTabStripRegionView::UpdateSoraWorkspaceSlide() {
+  views::View* const strip = tab_strip_view();
+  if (!strip || !strip->layer()) {
+    return;
+  }
+  // From a whole strip width away (Zen's translateX(±100%)) to its place.
+  gfx::Transform transform;
+  transform.Translate(sora_workspace_slide_from_ * strip->width() *
+                          (1.0 - sora_workspace_slide_.GetCurrentValue()),
+                      0);
+  strip->layer()->SetTransform(transform);
+}
+
+void VerticalTabStripRegionView::EndSoraWorkspaceSlide() {
+  if (views::View* const strip = tab_strip_view(); strip && strip->layer()) {
+    strip->layer()->SetTransform(gfx::Transform());
+  }
+  content_area_view_->layer()->SetMasksToBounds(sora_content_masked_);
 }
 
