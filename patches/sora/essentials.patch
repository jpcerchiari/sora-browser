+
+void TabView::PaintEssentialsTile(gfx::Canvas* canvas) {
+  const ui::ColorProvider* const color_provider = GetColorProvider();
+  if (!color_provider) {
+    return;
+  }
+
+  const gfx::Rect tile_bounds = GetLocalBounds();
+  const float hover_value =
+      IsHoverAnimationActive() ? static_cast<float>(GetHoverAnimationValue())
+                               : 0.0f;
+
+  gfx::ScopedCanvas scoped_canvas(canvas);
+  canvas->ClipPath(GetPath(), /*do_anti_alias=*/true);
+
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+
+  if (!active_) {
+    // Unselected: the toolbar element background, moving to the hover color.
+    flags.setColor(color_utils::AlphaBlend(
+        color_provider->GetColor(kColorSoraEssentialTileHover),
+        color_provider->GetColor(kColorToolbarBackgroundSubtleEmphasis),
+        hover_value));
+    canvas->DrawRect(tile_bounds, flags);
+    if (selected_) {
+      // Multi-selected tiles take the selected card over the whole tile.
+      flags.setColor(
+          color_provider->GetColor(kColorSoraEssentialTileSelectedCard));
+      canvas->DrawRect(tile_bounds, flags);
+    }
+    return;
+  }
+
+  // Selected: the favicon, blurred, as the tile background.
+  if (tab_data_.should_display_favicon && !tab_data_.favicon.IsEmpty()) {
+    const gfx::ImageSkia favicon =
+        tab_data_.favicon.Rasterize(color_provider);
+    if (!favicon.isNull() && favicon.width() > 0 && favicon.height() > 0) {
+      const int side = std::min(tile_bounds.width(), tile_bounds.height()) *
+                       kEssentialsFaviconBackdropScale;
+      const gfx::Point center = tile_bounds.CenterPoint();
+      cc::PaintFlags blur_flags;
+      blur_flags.setImageFilter(sk_make_sp<cc::BlurPaintFilter>(
+          kEssentialsFaviconBlurSigma, kEssentialsFaviconBlurSigma,
+          SkTileMode::kDecal, /*input=*/nullptr));
+      canvas->SaveLayerWithFlags(blur_flags);
+      canvas->DrawImageInt(favicon, 0, 0, favicon.width(), favicon.height(),
+                           center.x() - side / 2, center.y() - side / 2, side,
+                           side, /*filter=*/true);
+      canvas->Restore();
+    }
+  }
+
+  // The translucent card over it, lighter on hover.
+  gfx::RectF card_bounds(tile_bounds);
+  card_bounds.Inset(kEssentialsSelectedCardInset);
+  flags.setColor(color_utils::AlphaBlend(
+      color_provider->GetColor(kColorSoraEssentialTileSelectedCardHovered),
+      color_provider->GetColor(kColorSoraEssentialTileSelectedCard),
+      hover_value));
+  canvas->DrawRoundRect(card_bounds, kEssentialsSelectedCardRadius, flags);
+}
