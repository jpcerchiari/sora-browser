 namespace {
 constexpr int kTabPadding = 4;
+
+// Sora: Zen's Essentials grid (sora/zen-spec.md, section 3). Expanded, pinned
+// tabs are 46px tiles, at least 50px wide (the tile height plus 4px), placed
+// 5px from the strip edges with the 4px gap above.
+constexpr int kEssentialsTileHeight = 46;
+constexpr int kEssentialsMinTileWidth = 50;
+constexpr int kEssentialsHorizontalInset = 5;
+// Zen uses `minmax(48px, ...)` for the five-tile variant below.
+constexpr int kEssentialsFiveTilesMinTileWidth = 48;
+
+// One column of Zen's `repeat(auto-fit, minmax(max(<share>, <min>), 1fr))`.
+// `column_multiple` is 2 when Zen repeats the track in pairs.
+struct EssentialsColumnTrack {
+  float share;
+  int min_width;
+  int column_multiple;
+};
+
+// Zen swaps the column track by tile count so rows stay balanced
+// (ZenSpaceManager's "data-hack-type"): 6 or 9 tiles go in threes, 2 or 4 in
+// pairs, 5 in threes with a 25% share, anything else at 23.7%.
+EssentialsColumnTrack GetEssentialsColumnTrack(int count) {
+  if (count == 6 || count == 9) {
+    return {0.30f, kEssentialsMinTileWidth, 1};
+  }
+  if (count % 2 == 0 && count < 8) {
+    return {0.23f, kEssentialsMinTileWidth, 2};
+  }
+  if (count == 5) {
+    return {0.25f, kEssentialsFiveTilesMinTileWidth, 1};
+  }
+  return {0.237f, kEssentialsMinTileWidth, 1};
+}
+
+// Number of columns the auto-fit grid shows for `count` tiles in `width`.
+// Empty auto-fit tracks collapse, so a short row stretches over the width.
+int GetEssentialsColumnCount(int width, int count) {
+  const EssentialsColumnTrack track = GetEssentialsColumnTrack(count);
+  const int min_width =
+      std::max(base::ClampCeil(width * track.share), track.min_width);
+  int columns = (width + kTabPadding) / (min_width + kTabPadding);
+  columns -= columns % track.column_multiple;
+  return std::clamp(columns, 1, std::max(count, 1));
+}
+
+// Expanded, pinned tabs are Essentials tiles; collapsed, they keep the height
+// of the other tabs.
+int GetPinnedTileHeight(tabs::VerticalTabStripCollapseState state) {
+  return state == tabs::VerticalTabStripCollapseState::kExpanded
+             ? kEssentialsTileHeight
+             : GetLayoutConstant(LayoutConstant::kVerticalTabPinnedHeight);
+}
