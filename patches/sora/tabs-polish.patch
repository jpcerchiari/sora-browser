+      canvas->sk_canvas()->translate(size().width() / 2.0f,
+                                     size().height() / 2.0f);
+      canvas->sk_canvas()->rotate(direction * angle);
+      canvas->DrawRoundRect(bar, kSoraCrossBarRadius, flags);
+    }
+  }
+
+ private:
+  const SkColor color_;
+  const double progress_;
+};
