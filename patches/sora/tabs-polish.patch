+// Sora: Zen's tab open and close animations (sora/zen-spec.md, section 8):
+// opacity 0 -> 1 and scale 0.95 -> 1 in 0.12s to open, opacity 1 -> 0 and
+// scale 1 -> 0.95 in 0.1s to close. They ride the shared layout animation
+// (kLayoutAnimationDuration, which also grows or shrinks the row the way Zen
+// animates the margin), finishing at Zen's time into it.
+// Chromium's 200ms, named so that both stay in step.
+constexpr base::TimeDelta kLayoutAnimationDuration = base::Milliseconds(200);
+constexpr base::TimeDelta kSoraTabOpenDuration = base::Milliseconds(120);
+constexpr base::TimeDelta kSoraTabCloseDuration = base::Milliseconds(100);
+constexpr float kSoraTabAddRemoveMinScale = 0.95f;
+
+// Sora: how far a Zen animation of `duration` is at `value` of the layout
+// animation.
+double GetSoraAddRemoveProgress(double value, base::TimeDelta duration) {
+  return std::min(1.0, value * (kLayoutAnimationDuration / duration));
+}
+
+// Sora: fades and scales `view` (which paints to a layer) about the center of
+// `bounds` (its bounds this frame); `shown` is 0 for gone, 1 for at rest.
+void SetSoraAddRemoveState(views::View* view,
+                           const gfx::Rect& bounds,
+                           double shown) {
+  view->layer()->SetOpacity(static_cast<float>(shown));
+  const float scale =
+      gfx::Tween::FloatValueBetween(shown, kSoraTabAddRemoveMinScale, 1.0f);
+  view->layer()->SetTransform(
+      scale == 1.0f
+          ? gfx::Transform()
+          : gfx::TransformAboutPivot(
+                gfx::RectF(gfx::SizeF(bounds.size())).CenterPoint(),
+                gfx::Transform::MakeScale(scale)));
+}
+
+// Sora: undoes SetSoraAddRemoveState() on a view that is staying, unless the
+// view keeps its layer for its own transform (kSoraKeepLayerKey).
+void ResetSoraAddRemoveTransform(views::View* view) {
+  if (view->layer() && !view->GetProperty(kSoraKeepLayerKey) &&
+      !view->layer()->transform().IsIdentity()) {
+    view->layer()->SetTransform(gfx::Transform());
+  }
+}
+
