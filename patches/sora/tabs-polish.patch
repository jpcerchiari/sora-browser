+// Sora: the "X" at `progress` (0 = flat bar, 1 = cross) in a square of `size`.
+class SoraCrossImageSource : public gfx::CanvasImageSource {
+ public:
+  SoraCrossImageSource(int size, SkColor color, double progress)
+      : gfx::CanvasImageSource(gfx::Size(size, size)),
+        color_(color),
+        progress_(progress) {}
+  SoraCrossImageSource(const SoraCrossImageSource&) = delete;
+  SoraCrossImageSource& operator=(const SoraCrossImageSource&) = delete;
+  ~SoraCrossImageSource() override = default;
+
+  // gfx::CanvasImageSource:
+  void Draw(gfx::Canvas* canvas) override {
+    const float length = gfx::Tween::FloatValueBetween(
+        progress_, kSoraCrossStartLength, kSoraCrossEndLength);
+    const float angle =
+        gfx::Tween::FloatValueBetween(progress_, 0.0f, kSoraCrossEndAngle);
+    const gfx::RectF bar(-length / 2, -kSoraCrossBarThickness / 2, length,
+                         kSoraCrossBarThickness);
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setStyle(cc::PaintFlags::kFill_Style);
+    flags.setColor(color_);
