+}  // namespace tabs
+
+namespace views {
+class View;
+}  // namespace views
+
+// Sora: Zen's workspaces ("Spaces", sora/zen-spec.md section 11) on top of
+// Chromium's tab group focus mode (features::kTabGroupsFocusing).
+//
+// A workspace is a tab group of the window and the active workspace is the
+// focused group. Focus mode already does the rest natively: the strip shows
+// only the focused group's tabs plus the pinned tabs (Sora's essentials),
+// new tabs join the focused group, tab cycling and Ctrl+1..8 stay inside it,
+// and the group color tints the window. Groups and their names and colors
+// persist through session restore, and the active workspace comes back as
+// the group of the restored active tab.
+//
+// This class keeps that state Zen-like: there is always an active workspace
+// while the window has unpinned tabs, tabs without a group join it, and
+// activating a tab of another workspace switches to that workspace instead of
+// leaving focus mode. Model changes are applied from a posted task, never
+// from inside a TabStripModel notification.
+class SoraWorkspacesController : public TabStripModelObserver {
+ public:
+  SoraWorkspacesController(
+      BrowserWindowInterface* browser,
+      tabs::VerticalTabStripStateController* state_controller);
+  SoraWorkspacesController(const SoraWorkspacesController&) = delete;
+  SoraWorkspacesController& operator=(const SoraWorkspacesController&) =
+      delete;
+  ~SoraWorkspacesController() override;
+
+  // Whether workspaces are available: focus mode is on and the window
+  // supports tab groups.
+  bool IsEnabled() const;
+
+  // The workspaces of the window, in strip order.
+  std::vector<tab_groups::TabGroupId> GetWorkspaces() const;
+  // The active (focused) workspace, if any.
+  std::optional<tab_groups::TabGroupId> GetActiveWorkspace() const;
+  // Visual data (name, color) of `workspace`, or nullptr if it is gone.
+  const tab_groups::TabGroupVisualData* GetVisualData(
+      const tab_groups::TabGroupId& workspace) const;
+  // The name to show for `workspace`: its group title, or the default name
+  // when the title is empty.
+  std::u16string GetDisplayName(const tab_groups::TabGroupId& workspace) const;
+
+  // Makes `workspace` active and selects the tab last used in it.
+  void SwitchTo(const tab_groups::TabGroupId& workspace);
+  // Creates a workspace holding a new tab, makes it active and opens the
+  // editor so it can be named. The editor is anchored to the view set with
+  // SetEditorAnchor() if it is showing, else to `fallback_anchor_view`.
+  void CreateWorkspace(views::View* fallback_anchor_view);
+  // The view the editor of a new workspace points at: the indicator.
+  void SetEditorAnchor(views::View* anchor_view);
+  // Opens Chromium's group editor (rename, color, delete) for `workspace`.
+  void ShowEditor(const tab_groups::TabGroupId& workspace,
+                  views::View* anchor_view);
+
+  // Runs `callback` after the workspaces or the active one change.
+  base::CallbackListSubscription RegisterOnChanged(
+      base::RepeatingClosure callback);
+
+  base::WeakPtr<SoraWorkspacesController> GetWeakPtr() {
+    return weak_ptr_factory_.GetWeakPtr();
+  }
+
+ private:
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabPinnedStateChanged(tabs::TabInterface* tab, int index) override;
+  void TabGroupedStateChanged(TabStripModel* tab_strip_model,
+                              std::optional<tab_groups::TabGroupId> old_group,
+                              std::optional<tab_groups::TabGroupId> new_group,
+                              tabs::TabInterface* tab,
+                              int index) override;
+  void OnTabGroupChanged(const TabGroupChange& change) override;
+  void OnTabGroupFocusChanged(
+      std::optional<tab_groups::TabGroupId> new_focused_group_id,
+      std::optional<tab_groups::TabGroupId> old_focused_group_id) override;
+  void OnTabStripModelDestroyed(TabStripModel* tab_strip_model) override;
+
+  // Posts one Update() for any number of changes.
+  void ScheduleUpdate(base::TimeDelta delay = base::TimeDelta());
+  void Update();
+  // Restores the invariants described above. Returns false if the strip
+  // cannot be edited now (a drag is in progress) and should be retried.
+  bool EnsureActiveWorkspace();
+  // Expands `workspace` if it was collapsed: its header is hidden, so a
+  // collapsed workspace could never show its tabs.
+  void ExpandIfCollapsed(const tab_groups::TabGroupId& workspace);
+  void SetTitle(const tab_groups::TabGroupId& workspace,
+                const std::u16string& title);
+  // The tab to select when switching to `workspace`.
+  tabs::TabInterface* GetTabToSelect(const tab_groups::TabGroupId& workspace);
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<TabStripModel> model_ = nullptr;
+
+  // Last active tab of each workspace, as Zen's lastSelectedWorkspaceTabs.
+  std::map<tab_groups::TabGroupId, tabs::TabHandle> last_active_tabs_;
+  // The workspace that was active last, kept while the active tab is pinned
+  // or ungrouped.
+  std::optional<tab_groups::TabGroupId> last_workspace_;
+
+  bool update_pending_ = false;
+  base::RepeatingClosureList on_changed_callbacks_;
+  TabGroupEditorBubbleTracker editor_bubble_tracker_;
+  views::ViewTracker editor_anchor_;
+
+  base::WeakPtrFactory<SoraWorkspacesController> weak_ptr_factory_{this};
+};
+
