+// SoraWorkspaceIndicator ------------------------------------------------------
+
+SoraWorkspaceIndicator::SoraWorkspaceIndicator(
+    base::WeakPtr<SoraWorkspacesController> controller)
+    : views::Button(base::BindRepeating(&SoraWorkspaceIndicator::OnPressed,
+                                        base::Unretained(this))),
+      controller_(std::move(controller)) {
+  SetTriggerableEventFlags(ui::EF_LEFT_MOUSE_BUTTON |
+                           ui::EF_RIGHT_MOUSE_BUTTON);
+  name_label_ = AddChildView(std::make_unique<views::Label>());
+  name_label_->SetFontList(gfx::FontList()
+                               .DeriveWithSizeDelta(kSoraIndicatorNameSizeDelta)
+                               .DeriveWithWeight(gfx::Font::Weight::SEMIBOLD));
+  name_label_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  name_label_->SetElideBehavior(gfx::ELIDE_TAIL);
+  name_label_->SetAutoColorReadabilityEnabled(false);
+  name_label_->SetCanProcessEventsWithinSubtree(false);
+  // The backplate is see-through, as with the "+ New tab" row.
+  name_label_->SetSubpixelRenderingEnabled(false);
+
+  views::InstallRoundRectHighlightPathGenerator(
+      this, gfx::Insets::VH(kSoraIndicatorBackplateVerticalInset, 0),
+      static_cast<int>(kSoraIndicatorBackplateRadius));
+  views::FocusRing::Install(this);
+  Update();
+}
+
+SoraWorkspaceIndicator::~SoraWorkspaceIndicator() = default;
+
+void SoraWorkspaceIndicator::Update() {
+  std::optional<tab_groups::TabGroupId> workspace =
+      controller_ ? controller_->GetActiveWorkspace() : std::nullopt;
+  const tab_groups::TabGroupVisualData* visual_data =
+      workspace ? controller_->GetVisualData(*workspace) : nullptr;
+  if (!visual_data) {
+    workspace.reset();
+  }
+  workspace_ = workspace;
+  if (!workspace_) {
+    return;
+  }
+  const std::u16string name = controller_->GetDisplayName(*workspace_);
+  color_ = visual_data->color();
+  if (name_label_->GetText() != name) {
+    name_label_->SetText(name);
+    SetTooltipText(name);
+    GetViewAccessibility().SetName(name);
+  }
+  SchedulePaint();
+}
+
+gfx::Size SoraWorkspaceIndicator::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  return gfx::Size(0, kSoraIndicatorHeight);
+}
+
+void SoraWorkspaceIndicator::Layout(PassKey) {
+  LayoutSuperclass<views::Button>(this);
+  const int strip_padding =
+      GetLayoutConstant(LayoutConstant::kVerticalTabStripHorizontalPadding);
+  const int leading =
+      std::max(0, kSoraIndicatorLeadingPadding - strip_padding) +
+      kSoraIndicatorIconSize + kSoraIndicatorIconGap;
+  const int trailing =
+      std::max(0, kSoraIndicatorTrailingPadding - strip_padding);
+  // Child bounds are logical; views mirrors them in RTL.
+  gfx::Rect label_bounds = GetLocalBounds();
+  label_bounds.Inset(gfx::Insets::TLBR(0, leading, 0, trailing));
+  name_label_->SetBoundsRect(label_bounds);
+}
+
+void SoraWorkspaceIndicator::OnThemeChanged() {
+  views::Button::OnThemeChanged();
+  UpdateColors();
+}
+
+void SoraWorkspaceIndicator::AddedToWidget() {
+  views::Button::AddedToWidget();
+  paint_as_active_subscription_ =
+      GetWidget()->RegisterPaintAsActiveChangedCallback(base::BindRepeating(
+          &SoraWorkspaceIndicator::UpdateColors, base::Unretained(this)));
+}
+
+void SoraWorkspaceIndicator::RemovedFromWidget() {
+  paint_as_active_subscription_ = {};
+  views::Button::RemovedFromWidget();
+}
+
+void SoraWorkspaceIndicator::PaintButtonContents(gfx::Canvas* canvas) {
+  if (!workspace_) {
+    return;
+  }
+  const bool active_frame = ShouldPaintAsActive(this);
+  if (GetState() == STATE_HOVERED || GetState() == STATE_PRESSED) {
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(GetColorProvider()->GetColor(
+        active_frame ? kColorTabBackgroundInactiveHoverFrameActive
+                     : kColorTabBackgroundInactiveHoverFrameInactive));
+    gfx::RectF backplate(GetLocalBounds());
+    backplate.Inset(
+        gfx::InsetsF::VH(kSoraIndicatorBackplateVerticalInset, 0));
+    canvas->DrawRoundRect(backplate, kSoraIndicatorBackplateRadius, flags);
+  }
+  const int strip_padding =
+      GetLayoutConstant(LayoutConstant::kVerticalTabStripHorizontalPadding);
+  // Painting is not flipped in RTL, so the icon slot is mirrored here.
+  const gfx::Rect icon_bounds = GetMirroredRect(gfx::Rect(
+      std::max(0, kSoraIndicatorLeadingPadding - strip_padding),
+      (height() - kSoraIndicatorIconSize) / 2, kSoraIndicatorIconSize,
+      kSoraIndicatorIconSize));
+  PaintDot(canvas, gfx::RectF(icon_bounds).CenterPoint(),
+           GetWorkspaceColor(this, color_));
+}
+
+void SoraWorkspaceIndicator::OnPressed() {
+  if (controller_ && workspace_) {
+    controller_->ShowEditor(*workspace_, this);
+  }
+}
+
+void SoraWorkspaceIndicator::UpdateColors() {
+  if (!GetColorProvider()) {
+    return;
+  }
+  const ui::ColorId text_color = ShouldPaintAsActive(this)
+                                    ? kColorTabForegroundInactiveFrameActive
+                                    : kColorTabForegroundInactiveFrameInactive;
+  name_label_->SetEnabledColor(text_color);
+  SchedulePaint();
+}
+
+BEGIN_METADATA(SoraWorkspaceIndicator)
+END_METADATA
+
+// SoraWorkspaceSwitcher -------------------------------------------------------
+
+SoraWorkspaceSwitcher::SoraWorkspaceSwitcher(
+    base::WeakPtr<SoraWorkspacesController> controller)
+    : controller_(std::move(controller)) {
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets(),
+      kSoraWorkspaceButtonGap));
+  Update();
+}
+
+SoraWorkspaceSwitcher::~SoraWorkspaceSwitcher() = default;
+
+void SoraWorkspaceSwitcher::Update() {
+  std::vector<Entry> entries;
+  if (controller_) {
+    const std::optional<tab_groups::TabGroupId> active =
+        controller_->GetActiveWorkspace();
+    for (const tab_groups::TabGroupId& id : controller_->GetWorkspaces()) {
+      const tab_groups::TabGroupVisualData* visual_data =
+          controller_->GetVisualData(id);
+      if (!visual_data) {
+        continue;
+      }
+      entries.push_back({id, controller_->GetDisplayName(id),
+                         visual_data->color(), id == active});
+    }
+  }
+  if (entries == entries_) {
+    return;
+  }
+  const bool same_workspaces = std::ranges::equal(
+      entries, entries_, {}, &Entry::id, &Entry::id);
+  entries_ = std::move(entries);
+  if (!same_workspaces) {
+    RemoveAllChildViews();
+    for (const Entry& entry : entries_) {
+      AddChildView(
+          std::make_unique<SoraWorkspaceButton>(controller_, entry.id));
+    }
+    PreferredSizeChanged();
+  }
+  for (size_t i = 0; i < entries_.size(); ++i) {
+    auto* const button =
+        views::AsViewClass<SoraWorkspaceButton>(children()[i]);
+    if (button) {
+      button->SetData(entries_[i].name, entries_[i].color, entries_[i].active);
+    }
+  }
+}
+
+bool SoraWorkspaceSwitcher::IsPointOnButton(const gfx::Point& point) const {
+  for (const views::View* child : children()) {
+    gfx::Point point_in_child = point;
+    views::View::ConvertPointToTarget(this, child, &point_in_child);
+    if (child->GetVisible() && child->HitTestPoint(point_in_child)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+BEGIN_METADATA(SoraWorkspaceSwitcher)
+END_METADATA
