+// Workspace indicator (sora/zen-spec.md, section 3; zen-workspaces.css,
+// .zen-current-workspace-indicator).
+constexpr int kSoraIndicatorHeight = 44;
+// Zen measures the text start from the sidebar edge (3px + 8px tab padding +
+// 5px sidebar padding) and the end padding as 12px. The row sits inside the
+// strip's horizontal padding, so that padding is taken off.
+constexpr int kSoraIndicatorLeadingPadding = 16;
+constexpr int kSoraIndicatorTrailingPadding = 12;
+constexpr int kSoraIndicatorIconSize = 16;
+// --toolbarbutton-inner-padding (8px [FF]) - 1px.
+constexpr int kSoraIndicatorIconGap = 7;
+// Name in 13px ("font-size: small") at weight 600; the UI font is 12px.
+constexpr int kSoraIndicatorNameSizeDelta = 1;
+// Hover backplate: 4px in from the top and bottom, the tab radius (14px
+// squircle, ~6px round), the tab hover color.
+constexpr int kSoraIndicatorBackplateVerticalInset = 4;
+constexpr float kSoraIndicatorBackplateRadius = 6.0f;
+
+// Footer workspace icons (zen-workspaces.css, #zen-workspaces-button).
+constexpr int kSoraWorkspaceButtonSize = 30;
+constexpr float kSoraWorkspaceButtonRadius = 6.0f;
+constexpr int kSoraWorkspaceButtonGap = 4;  // 0.5ch.
+// A workspace without an icon shows a dot. Sora has no workspace icons yet,
+// so the dot is drawn for every workspace, in the workspace color.
+constexpr float kSoraWorkspaceDotDiameter = 8.0f;
+// Inactive icons: grayscale at 70% opacity.
+constexpr float kSoraInactiveWorkspaceOpacity = 0.7f;
+
+bool ShouldPaintAsActive(const views::View* view) {
+  const views::Widget* widget = view->GetWidget();
+  return !widget || widget->ShouldPaintAsActive();
+}
+
+// The workspace color as the tab strip draws its groups.
+SkColor GetWorkspaceColor(const views::View* view,
+                          tab_groups::TabGroupColorId color) {
+  return view->GetColorProvider()->GetColor(
+      GetTabGroupTabStripColorId(color, ShouldPaintAsActive(view)));
+}
+
+void PaintDot(gfx::Canvas* canvas, const gfx::PointF& center, SkColor color) {
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setStyle(cc::PaintFlags::kFill_Style);
+  flags.setColor(color);
+  canvas->DrawCircle(center, kSoraWorkspaceDotDiameter / 2, flags);
+}
+
+// One footer icon.
+class SoraWorkspaceButton : public views::Button {
+  METADATA_HEADER(SoraWorkspaceButton, views::Button)
+
+ public:
+  SoraWorkspaceButton(base::WeakPtr<SoraWorkspacesController> controller,
+                      const tab_groups::TabGroupId& workspace)
+      : views::Button(base::BindRepeating(&SoraWorkspaceButton::OnPressed,
+                                          base::Unretained(this))),
+        controller_(std::move(controller)),
+        workspace_(workspace) {
+    SetTriggerableEventFlags(ui::EF_LEFT_MOUSE_BUTTON |
+                             ui::EF_RIGHT_MOUSE_BUTTON);
+    views::InstallRoundRectHighlightPathGenerator(
+        this, gfx::Insets(), static_cast<int>(kSoraWorkspaceButtonRadius));
+    views::FocusRing::Install(this);
+  }
+  SoraWorkspaceButton(const SoraWorkspaceButton&) = delete;
+  SoraWorkspaceButton& operator=(const SoraWorkspaceButton&) = delete;
+  ~SoraWorkspaceButton() override = default;
+
+  // Updated in place, so that an editor bubble anchored here survives a
+  // rename.
+  void SetData(const std::u16string& name,
+               tab_groups::TabGroupColorId color,
+               bool active) {
+    if (name != name_) {
+      name_ = name;
+      SetTooltipText(name);
+      GetViewAccessibility().SetName(name);
+    }
+    color_ = color;
+    active_ = active;
+    SchedulePaint();
+  }
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(kSoraWorkspaceButtonSize, kSoraWorkspaceButtonSize);
+  }
+
+ protected:
+  // views::Button:
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    const bool hovered =
+        GetState() == STATE_HOVERED || GetState() == STATE_PRESSED;
+    if (hovered) {
+      // Hover: --zen-toolbar-element-bg, which Sora maps to the subtle
+      // toolbar emphasis color (color-mixer.patch).
+      cc::PaintFlags flags;
+      flags.setAntiAlias(true);
+      flags.setColor(GetColorProvider()->GetColor(
+          kColorToolbarBackgroundSubtleEmphasis));
+      canvas->DrawRoundRect(gfx::RectF(GetLocalBounds()),
+                            kSoraWorkspaceButtonRadius, flags);
+    }
+    SkColor dot_color = GetWorkspaceColor(this, color_);
+    if (!active_ && !hovered) {
+      const uint8_t luma = color_utils::GetLuma(dot_color);
+      dot_color = SkColorSetARGB(
+          base::ClampRound<uint8_t>(SkColorGetA(dot_color) *
+                                    kSoraInactiveWorkspaceOpacity),
+          luma, luma, luma);
+    }
+    PaintDot(canvas, gfx::RectF(GetLocalBounds()).CenterPoint(), dot_color);
+  }
+
+ private:
+  void OnPressed(const ui::Event& event) {
+    if (!controller_) {
+      return;
+    }
+    if (event.IsMouseEvent() && event.AsMouseEvent()->IsRightMouseButton()) {
+      controller_->ShowEditor(workspace_, this);
+      return;
+    }
+    controller_->SwitchTo(workspace_);
+  }
+
+  base::WeakPtr<SoraWorkspacesController> controller_;
+  const tab_groups::TabGroupId workspace_;
+  std::u16string name_;
+  tab_groups::TabGroupColorId color_ = tab_groups::TabGroupColorId::kGrey;
+  bool active_ = false;
+};
