+void VerticalTabStripBottomContainer::SetSoraWorkspaces(
+    base::WeakPtr<SoraWorkspacesController> workspaces) {
+  if (sora_workspace_switcher_ || !workspaces || !workspaces->IsEnabled()) {
+    return;
+  }
+  sora_workspaces_ = workspaces;
+
+  // Zen's footer: library, workspace icons, "+". Sora keeps downloads in
+  // place of the library and the collapse toggle at the end:
+  // downloads | <flex> | icons | <flex> | + | collapse.
+  size_t index = sora_footer_->children().size();
+  if (sora_collapse_button_) {
+    index = sora_footer_->GetIndexOf(sora_collapse_button_).value_or(index);
+  }
+  auto switcher = std::make_unique<SoraWorkspaceSwitcher>(workspaces);
+  switcher->SetProperty(
+      views::kFlexBehaviorKey,
+      views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToZero,
+                               views::MaximumFlexSizeRule::kPreferred));
+  sora_workspace_switcher_ =
+      sora_footer_->AddChildViewAt(std::move(switcher), index++);
+  sora_footer_
+      ->AddChildViewAt(std::make_unique<views::View>(), index++)
+      ->SetProperty(
+          views::kFlexBehaviorKey,
+          views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToZero,
+                                   views::MaximumFlexSizeRule::kUnbounded));
+
+  auto new_workspace_button = std::make_unique<TopContainerButton>();
+  new_workspace_button->SetIconSize(kSoraFooterIconSize);
+  new_workspace_button->SetPreferredSize(
+      gfx::Size(kSoraFooterButtonSize, kSoraFooterButtonSize));
+  views::InstallRoundRectHighlightPathGenerator(
+      new_workspace_button.get(), gfx::Insets(), kSoraFooterButtonRadius);
+  // Same icon as the new tab action.
+  new_workspace_button->UpdateIcon(ui::ImageModel::FromVectorIcon(
+      features::IsRoundedIconsEnabled() ? vector_icons::kAddWeight500CustomIcon
+                                        : vector_icons::kAddOldIcon,
+      ui::kColorIcon));
+  new_workspace_button->SetTooltipText(kSoraNewWorkspaceTooltip);
+  new_workspace_button->GetViewAccessibility().SetName(
+      kSoraNewWorkspaceTooltip);
+  views::LabelButton* const new_workspace_button_ptr =
+      new_workspace_button.get();
+  new_workspace_button->SetCallback(base::BindRepeating(
+      [](base::WeakPtr<SoraWorkspacesController> workspaces,
+         views::View* button) {
+        if (workspaces) {
+          workspaces->CreateWorkspace(button);
+        }
+      },
+      workspaces, base::Unretained(new_workspace_button_ptr)));
+  sora_new_workspace_button_ =
+      sora_footer_->AddChildViewAt(std::move(new_workspace_button), index);
+}
+
+void VerticalTabStripBottomContainer::UpdateSoraWorkspaces() {
+  if (sora_workspace_switcher_) {
+    sora_workspace_switcher_->Update();
+  }
+}
