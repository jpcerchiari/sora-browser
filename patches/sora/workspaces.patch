@@ -0,0 +1,367 @@
+// Copyright 2026 The Sora Browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/vertical/sora_workspaces_controller.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/feature_list.h"
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/browser_tabstrip.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_group_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_delegate.h"
+#include "chrome/browser/ui/ui_features.h"
+#include "chrome/browser/ui/views/tabs/groups/tab_group_editor_bubble_view.h"
+#include "components/tab_groups/tab_group_visual_data.h"
+#include "components/tabs/public/tab_group.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+#include "url/gurl.h"
+
+namespace {
+
+// Zen names new workspaces "Space" (ZenSpaceManager.mjs,
+// createAndSaveWorkspace). Sora has no string resources yet.
+// TODO(sora): move to a Sora .grd once there is one.
+constexpr char16_t kSoraDefaultWorkspaceName[] = u"Space";
+
+// While a tab drag is in progress the strip cannot be edited; check again
+// after this delay.
+constexpr base::TimeDelta kSoraRetryDelay = base::Milliseconds(250);
+
+}  // namespace
+
+SoraWorkspacesController::SoraWorkspacesController(
+    BrowserWindowInterface* browser,
+    tabs::VerticalTabStripStateController* state_controller)
+    : browser_(browser),
+      model_(browser->GetTabStripModel()),
+      editor_bubble_tracker_(state_controller) {
+  model_->AddObserver(this);
+  ScheduleUpdate();
+}
+
+SoraWorkspacesController::~SoraWorkspacesController() {
+  if (model_) {
+    model_->RemoveObserver(this);
+  }
+}
+
+bool SoraWorkspacesController::IsEnabled() const {
+  // EnterFocusMode() CHECKs this feature. Sora turns it on by default
+  // (ui_features.cc); someone may still turn it off in chrome://flags.
+  return model_ && model_->SupportsTabGroups() &&
+         base::FeatureList::IsEnabled(features::kTabGroupsFocusing);
+}
+
+std::vector<tab_groups::TabGroupId> SoraWorkspacesController::GetWorkspaces()
+    const {
+  if (!IsEnabled()) {
+    return {};
+  }
+  TabGroupModel* const group_model = model_->group_model();
+  std::vector<tab_groups::TabGroupId> workspaces;
+  for (const tab_groups::TabGroupId& group : group_model->ListTabGroups()) {
+    // Ephemeral groups only back Chromium's "focus tabs" mode; they are not
+    // workspaces.
+    if (!model_->IsEphemeralTabGroup(group) &&
+        !group_model->GetTabGroup(group)->IsEmpty()) {
+      workspaces.push_back(group);
+    }
+  }
+  // Same order as FocusNextTabGroup() and the strip: by first tab.
+  std::ranges::sort(workspaces, {}, [&](const tab_groups::TabGroupId& id) {
+    return group_model->GetTabGroup(id)->ListTabs().start();
+  });
+  return workspaces;
+}
+
+std::optional<tab_groups::TabGroupId>
+SoraWorkspacesController::GetActiveWorkspace() const {
+  if (!IsEnabled()) {
+    return std::nullopt;
+  }
+  std::optional<tab_groups::TabGroupId> focused = model_->GetFocusedGroup();
+  if (focused && model_->IsEphemeralTabGroup(*focused)) {
+    return std::nullopt;
+  }
+  return focused;
+}
+
+const tab_groups::TabGroupVisualData* SoraWorkspacesController::GetVisualData(
+    const tab_groups::TabGroupId& workspace) const {
+  if (!IsEnabled() || !model_->group_model()->ContainsTabGroup(workspace)) {
+    return nullptr;
+  }
+  return model_->group_model()->GetTabGroup(workspace)->visual_data();
+}
+
+std::u16string SoraWorkspacesController::GetDisplayName(
+    const tab_groups::TabGroupId& workspace) const {
+  const tab_groups::TabGroupVisualData* visual_data = GetVisualData(workspace);
+  if (!visual_data || visual_data->title().empty()) {
+    return kSoraDefaultWorkspaceName;
+  }
+  return visual_data->title();
+}
+
+void SoraWorkspacesController::SwitchTo(
+    const tab_groups::TabGroupId& workspace) {
+  if (!IsEnabled() || !model_->group_model()->ContainsTabGroup(workspace) ||
+      GetActiveWorkspace() == workspace) {
+    return;
+  }
+  ExpandIfCollapsed(workspace);
+  last_workspace_ = workspace;
+  // Selecting a tab outside the focused group ends focus mode, and entering
+  // focus mode for a group whose tab is already active keeps that tab.
+  if (tabs::TabInterface* tab = GetTabToSelect(workspace)) {
+    model_->ActivateTab(
+        tab, TabStripUserGestureDetails(
+                 TabStripUserGestureDetails::GestureType::kOther));
+  }
+  if (model_->group_model()->ContainsTabGroup(workspace)) {
+    model_->EnterFocusMode(workspace);
+  }
+}
+
+void SoraWorkspacesController::CreateWorkspace(
+    views::View* fallback_anchor_view) {
+  if (!IsEnabled()) {
+    return;
+  }
+  // Out of focus mode the new tab is not put in the focused group, and
+  // appended at the end it does not join the last group either.
+  model_->ExitFocusMode();
+  content::WebContents* const contents = chrome::AddAndReturnTabAt(
+      browser_, GURL(), /*index=*/-1, /*foreground=*/true);
+  int index = contents ? model_->GetIndexOfWebContents(contents)
+                       : TabStripModel::kNoTab;
+  if (index == TabStripModel::kNoTab || model_->IsTabPinned(index)) {
+    ScheduleUpdate();
+    return;
+  }
+  if (model_->GetTabGroupForTab(index).has_value()) {
+    model_->RemoveFromGroup({index});
+    // Leaving the group may move the tab.
+    index = model_->GetIndexOfWebContents(contents);
+  }
+  // The new group gets the next unused color, like any new tab group.
+  const tab_groups::TabGroupId workspace = model_->AddToNewGroup({index});
+  SetTitle(workspace, kSoraDefaultWorkspaceName);
+  last_workspace_ = workspace;
+  model_->EnterFocusMode(workspace);
+  // Zen opens a creation form to name the new space; Sora opens the group
+  // editor with the name field focused.
+  views::View* const anchor_view =
+      editor_anchor_.view() && editor_anchor_.view()->IsDrawn()
+          ? editor_anchor_.view()
+          : fallback_anchor_view;
+  ShowEditor(workspace, anchor_view);
+}
+
+void SoraWorkspacesController::SetEditorAnchor(views::View* anchor_view) {
+  editor_anchor_.SetView(anchor_view);
+}
+
+void SoraWorkspacesController::ShowEditor(
+    const tab_groups::TabGroupId& workspace,
+    views::View* anchor_view) {
+  if (!IsEnabled() || !anchor_view || editor_bubble_tracker_.is_open() ||
+      !model_->group_model()->ContainsTabGroup(workspace)) {
+    return;
+  }
+  std::unique_ptr<views::Widget> bubble = TabGroupEditorBubbleView::Show(
+      browser_, workspace, anchor_view, /*anchor_rect=*/std::nullopt,
+      /*stop_context_menu_propagation=*/false);
+  if (bubble) {
+    editor_bubble_tracker_.Opened(std::move(bubble));
+  }
+}
+
+base::CallbackListSubscription SoraWorkspacesController::RegisterOnChanged(
+    base::RepeatingClosure callback) {
+  return on_changed_callbacks_.Add(std::move(callback));
+}
+
+void SoraWorkspacesController::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (selection.active_tab_changed() && selection.new_tab) {
+    if (std::optional<tab_groups::TabGroupId> group =
+            selection.new_tab->GetGroup()) {
+      last_active_tabs_[*group] = selection.new_tab->GetHandle();
+    }
+  }
+  ScheduleUpdate();
+}
+
+void SoraWorkspacesController::OnTabPinnedStateChanged(tabs::TabInterface* tab,
+                                                       int index) {
+  ScheduleUpdate();
+}
+
+void SoraWorkspacesController::TabGroupedStateChanged(
+    TabStripModel* tab_strip_model,
+    std::optional<tab_groups::TabGroupId> old_group,
+    std::optional<tab_groups::TabGroupId> new_group,
+    tabs::TabInterface* tab,
+    int index) {
+  ScheduleUpdate();
+}
+
+void SoraWorkspacesController::OnTabGroupChanged(const TabGroupChange& change) {
+  if (change.type == TabGroupChange::kClosed) {
+    last_active_tabs_.erase(change.group);
+  }
+  ScheduleUpdate();
+}
+
+void SoraWorkspacesController::OnTabGroupFocusChanged(
+    std::optional<tab_groups::TabGroupId> new_focused_group_id,
+    std::optional<tab_groups::TabGroupId> old_focused_group_id) {
+  if (new_focused_group_id) {
+    last_workspace_ = new_focused_group_id;
+  }
+  ScheduleUpdate();
+}
+
+void SoraWorkspacesController::OnTabStripModelDestroyed(
+    TabStripModel* tab_strip_model) {
+  model_->RemoveObserver(this);
+  model_ = nullptr;
+  weak_ptr_factory_.InvalidateWeakPtrs();
+}
+
+void SoraWorkspacesController::ScheduleUpdate(base::TimeDelta delay) {
+  if (update_pending_) {
+    return;
+  }
+  update_pending_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&SoraWorkspacesController::Update,
+                     weak_ptr_factory_.GetWeakPtr()),
+      delay);
+}
+
+void SoraWorkspacesController::Update() {
+  update_pending_ = false;
+  if (!model_) {
+    return;
+  }
+  if (!EnsureActiveWorkspace()) {
+    ScheduleUpdate(kSoraRetryDelay);
+  }
+  on_changed_callbacks_.Notify();
+}
+
+bool SoraWorkspacesController::EnsureActiveWorkspace() {
+  if (!IsEnabled() || model_->empty() || model_->closing_all() ||
+      !model_->delegate()->IsNormalWindow()) {
+    return true;
+  }
+  if (!model_->delegate()->IsTabStripEditable()) {
+    return false;
+  }
+  TabGroupModel* const group_model = model_->group_model();
+  std::optional<tab_groups::TabGroupId> target = model_->GetFocusedGroup();
+  if (target && model_->IsEphemeralTabGroup(*target)) {
+    // Chromium's "focus tabs" mode on ungrouped tabs; leave it alone.
+    return true;
+  }
+
+  if (!target) {
+    // Focus mode ended: the user selected a tab of another workspace, closed
+    // the last tab of the active one, or the window was just restored. As in
+    // Zen, the workspace of the selected tab becomes the active one.
+    tabs::TabInterface* const active_tab = model_->GetActiveTab();
+    if (active_tab && active_tab->GetGroup() &&
+        !model_->IsEphemeralTabGroup(*active_tab->GetGroup())) {
+      target = active_tab->GetGroup();
+    } else if (last_workspace_ &&
+               group_model->ContainsTabGroup(*last_workspace_)) {
+      target = last_workspace_;
+    } else if (std::vector<tab_groups::TabGroupId> workspaces =
+                   GetWorkspaces();
+               !workspaces.empty()) {
+      target = workspaces.front();
+    }
+  }
+
+  // Unpinned tabs without a workspace join the active one, as in Zen. This
+  // also turns the tabs of a window from before Sora had workspaces into the
+  // default workspace.
+  std::vector<int> loose_tabs;
+  for (int index = model_->IndexOfFirstNonPinnedTab(); index < model_->count();
+       ++index) {
+    if (!model_->GetTabGroupForTab(index).has_value()) {
+      loose_tabs.push_back(index);
+    }
+  }
+  if (!loose_tabs.empty()) {
+    if (target) {
+      model_->AddToExistingGroup(loose_tabs, *target);
+    } else {
+      target = model_->AddToNewGroup(loose_tabs);
+      SetTitle(*target, kSoraDefaultWorkspaceName);
+    }
+  }
+
+  // Only pinned tabs (essentials) are left: there is no group to focus, and
+  // the next unpinned tab starts the default workspace.
+  if (!target || !group_model->ContainsTabGroup(*target) ||
+      group_model->GetTabGroup(*target)->IsEmpty()) {
+    return true;
+  }
+  if (model_->GetFocusedGroup() != target) {
+    ExpandIfCollapsed(*target);
+    model_->EnterFocusMode(*target);
+  }
+  return true;
+}
+
+void SoraWorkspacesController::ExpandIfCollapsed(
+    const tab_groups::TabGroupId& workspace) {
+  const tab_groups::TabGroupVisualData* visual_data = GetVisualData(workspace);
+  if (!visual_data || !visual_data->is_collapsed()) {
+    return;
+  }
+  model_->ChangeTabGroupVisuals(
+      workspace,
+      tab_groups::TabGroupVisualData(visual_data->title(), visual_data->color(),
+                                     /*is_collapsed=*/false));
+}
+
+void SoraWorkspacesController::SetTitle(const tab_groups::TabGroupId& workspace,
+                                        const std::u16string& title) {
+  const tab_groups::TabGroupVisualData* visual_data = GetVisualData(workspace);
+  if (!visual_data) {
+    return;
+  }
+  model_->ChangeTabGroupVisuals(
+      workspace, tab_groups::TabGroupVisualData(title, visual_data->color(),
+                                                /*is_collapsed=*/false));
+}
+
+tabs::TabInterface* SoraWorkspacesController::GetTabToSelect(
+    const tab_groups::TabGroupId& workspace) {
+  if (auto it = last_active_tabs_.find(workspace);
+      it != last_active_tabs_.end()) {
+    tabs::TabInterface* const tab = it->second.Get();
+    if (tab && tab->GetGroup() == workspace &&
+        model_->GetIndexOfTab(tab) != TabStripModel::kNoTab) {
+      return tab;
+    }
+  }
+  return model_->group_model()->GetTabGroup(workspace)->GetFirstTab();
+}
