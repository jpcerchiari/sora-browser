+// ShadowValue blur is twice the CSS blur (see ui/gfx/shadow_value.cc).
+constexpr gfx::Vector2d kSoraFloatingShadowOffset(0, 30);
+constexpr double kSoraFloatingShadowBlur = 2 * 140;
+constexpr float kSoraFloatingShadowSpread = -15;
+constexpr SkAlpha kSoraFloatingShadowAlphaLight = 0xCC;
+constexpr SkAlpha kSoraFloatingShadowAlphaDark = 0x99;
+// 0.5px outline: black at 20% (light) or #4a4a4a (dark).
+constexpr float kSoraFloatingOutlineWidth = 0.5f;
+constexpr SkColor kSoraFloatingOutlineLight = SkColorSetARGB(0x33, 0, 0, 0);
+constexpr SkColor kSoraFloatingOutlineDark = SkColorSetRGB(0x4A, 0x4A, 0x4A);
+
+gfx::ShadowValues GetSoraFloatingShadows(bool dark) {
+  return {gfx::ShadowValue(
+      kSoraFloatingShadowOffset, kSoraFloatingShadowBlur,
+      SkColorSetA(SK_ColorBLACK, dark ? kSoraFloatingShadowAlphaDark
+                                      : kSoraFloatingShadowAlphaLight))};
+}
+
+// Sora: hosts the omnibox textfield while it floats. It is the last child of
+// the browser widget's root view, so it paints over the page, and it is
+// ignored by the root view's fill layout. Its bounds include the shadow; only
+// the field itself takes events. The results popup anchors to the field (see
+// LocationBarView::BoundsInScreen()) and paints its own frame around it.
+class SoraFloatingOmniboxHost : public views::View,
+                                public views::ViewObserver,
+                                public views::ViewTargeterDelegate {
+  METADATA_HEADER(SoraFloatingOmniboxHost, views::View)
+
+ public:
+  explicit SoraFloatingOmniboxHost(base::RepeatingClosure on_bounds_changed)
+      : on_bounds_changed_(std::move(on_bounds_changed)) {
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+    SetEventTargeter(std::make_unique<views::ViewTargeter>(this));
+    SetProperty(views::kViewIgnoredByLayoutKey, true);
+    SetVisible(false);
+  }
+  SoraFloatingOmniboxHost(const SoraFloatingOmniboxHost&) = delete;
+  SoraFloatingOmniboxHost& operator=(const SoraFloatingOmniboxHost&) = delete;
+  ~SoraFloatingOmniboxHost() override = default;
+
+  // Follows the size of the parent, the widget's root view.
+  void ObserveParent() {
+    parent_observation_.Reset();
+    if (parent()) {
+      parent_observation_.Observe(parent());
+    }
+    UpdateBounds();
+  }
+
+  gfx::Rect GetFieldBoundsInScreen() const {
+    gfx::Rect bounds = field_bounds_;
+    views::View::ConvertRectToScreen(this, &bounds);
+    return bounds;
+  }
+
+  void UpdateBounds() {
+    if (!parent()) {
+      return;
+    }
+    const gfx::Size area = parent()->size();
+    const int width = std::min(
+        area.width(),
+        std::max(std::min(base::ClampRound(area.width() /
+                                           kSoraFloatingWidthDivisor),
+                          kSoraFloatingMaxWidth),
+                 std::min(base::ClampRound(area.width() *
+                                           kSoraFloatingMinWidthFraction),
+                          kSoraFloatingMinWidthCap)));
+    const int top =
+        area.height() / 2 -
+        std::max(kSoraFloatingMinBlockHeight, kSoraFloatingHeight) / 2;
+    const gfx::Rect field((area.width() - width) / 2, top, width,
+                          kSoraFloatingHeight);
+
+    gfx::Rect bounds = field;
+    bounds.Inset(gfx::ShadowValue::GetMargin(GetSoraFloatingShadows(false)));
+    field_bounds_ = field - bounds.OffsetFromOrigin();
+    if (bounds == this->bounds()) {
+      return;
+    }
+    SetBoundsRect(bounds);
+    InvalidateLayout();
+    SchedulePaint();
+    on_bounds_changed_.Run();
+  }
+
+  // views::View:
+  void Layout(PassKey) override {
+    gfx::Rect contents = field_bounds_;
+    contents.Inset(gfx::Insets::VH(0, kSoraFloatingInlineMargin));
+    for (views::View* child : children()) {
+      child->SetBoundsRect(contents);
+    }
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    const SkColor surface =
+        GetColorProvider()->GetColor(kColorOmniboxResultsBackground);
+    const bool dark = color_utils::IsDark(surface);
+    const gfx::RectF field(field_bounds_);
+
+    // The negative spread shrinks the shape that casts the shadow; the field
+    // painted on top hides it.
+    gfx::RectF caster = field;
+    caster.Inset(-kSoraFloatingShadowSpread);
+    cc::PaintFlags shadow_flags;
+    shadow_flags.setAntiAlias(true);
+    shadow_flags.setColor(surface);
+    shadow_flags.setLooper(
+        gfx::CreateShadowDrawLooper(GetSoraFloatingShadows(dark)));
+    canvas->DrawRoundRect(caster, kSoraFloatingRadius, shadow_flags);
+
+    cc::PaintFlags fill_flags;
+    fill_flags.setAntiAlias(true);
+    fill_flags.setColor(surface);
+    canvas->DrawRoundRect(field, kSoraFloatingRadius, fill_flags);
+
+    gfx::RectF outline = field;
+    outline.Outset(kSoraFloatingOutlineWidth / 2);
+    cc::PaintFlags outline_flags;
+    outline_flags.setAntiAlias(true);
+    outline_flags.setStyle(cc::PaintFlags::kStroke_Style);
+    outline_flags.setStrokeWidth(kSoraFloatingOutlineWidth);
+    outline_flags.setColor(dark ? kSoraFloatingOutlineDark
+                                : kSoraFloatingOutlineLight);
+    canvas->DrawRoundRect(outline,
+                          kSoraFloatingRadius + kSoraFloatingOutlineWidth / 2,
+                          outline_flags);
+  }
+
+  void OnThemeChanged() override {
+    views::View::OnThemeChanged();
+    SchedulePaint();
+  }
+
+  // views::ViewObserver:
+  void OnViewBoundsChanged(views::View* observed_view) override {
+    UpdateBounds();
+  }
+  void OnViewIsDeleting(views::View* observed_view) override {
+    parent_observation_.Reset();
+  }
+
+  // views::ViewTargeterDelegate:
+  bool DoesIntersectRect(const views::View* target,
+                         const gfx::Rect& rect) const override {
+    return field_bounds_.Intersects(rect);
+  }
+
+ private:
+  base::RepeatingClosure on_bounds_changed_;
+  // The field, in this view's coordinates.
+  gfx::Rect field_bounds_;
+  base::ScopedObservation<views::View, views::ViewObserver>
+      parent_observation_{this};
+};
