+bool LocationBarView::SoraShouldFloatOnFocus() const {
+  // Zen floats the URL bar when it opens from the keyboard (Ctrl+L, F6, Tab)
+  // or for a new tab, not when it is clicked. Normal browser windows only.
+  if (is_popup_mode_ || is_full_webui_omnibox_ || !browser_ ||
+      browser_->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL ||
+      !GetWidget() || !GetWidget()->GetRootView() || !IsDrawn()) {
+    return false;
+  }
+  // Focus coming back to the omnibox (window activation) stays in place.
+  const views::FocusManager* const focus_manager = GetFocusManager();
+  if (focus_manager && focus_manager->focus_change_reason() ==
+                           views::FocusManager::FocusChangeReason::kFocusRestore) {
+    return false;
+  }
+  return !omnibox_view_->SoraIsPointerDown();
+}
+
+void LocationBarView::SoraSetFloating(bool floating) {
+  if (floating == sora_floating_) {
+    return;
+  }
+
+  auto* host =
+      views::AsViewClass<SoraFloatingOmniboxHost>(sora_floating_host_.view());
+  if (floating) {
+    views::View* const root = GetWidget() ? GetWidget()->GetRootView() : nullptr;
+    if (!root) {
+      return;
+    }
+    if (!host) {
+      host = root->AddChildView(std::make_unique<SoraFloatingOmniboxHost>(
+          base::BindRepeating(&LocationBarView::SoraOnFloatingBoundsChanged,
+                              weak_factory_.GetWeakPtr())));
+      sora_floating_host_.SetView(host);
+    }
+    // Stay above anything added to the root view since the last time.
+    root->ReorderChildView(host, root->children().size());
+    host->ObserveParent();
+    host->SetVisible(true);
+
+    sora_floating_ = true;
+    sora_omnibox_index_ = GetIndexOf(omnibox_view_.get());
+    host->AddChildViewRaw(omnibox_view_.get());
+
+    sora_saved_font_list_ = omnibox_view_->GetFontList();
+    omnibox_view_->SetFontList(sora_saved_font_list_->DeriveWithSizeDelta(
+        base::ClampRound(sora_saved_font_list_->GetFontSize() *
+                         (kSoraFloatingFontScale - 1))));
+    omnibox_view_->SoraUpdateTextWeight();
+
+    // The placeholder takes no clicks.
+    sora_saved_can_process_events_ = GetCanProcessEventsWithinSubtree();
+    SetCanProcessEventsWithinSubtree(false);
+    host->InvalidateLayout();
+  } else {
+    sora_floating_ = false;
+    if (omnibox_view_->parent() != this) {
+      AddChildViewAt(omnibox_view_.get(),
+                     std::min(sora_omnibox_index_.value_or(children().size()),
+                              children().size()));
+    }
+    sora_omnibox_index_.reset();
+    if (sora_saved_font_list_) {
+      omnibox_view_->SetFontList(*sora_saved_font_list_);
+      omnibox_view_->SoraUpdateTextWeight();
+      sora_saved_font_list_.reset();
+    }
+    SetCanProcessEventsWithinSubtree(sora_saved_can_process_events_);
+    if (host) {
