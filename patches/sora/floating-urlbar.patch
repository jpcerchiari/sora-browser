+constexpr float kSoraFloatingWidthDivisor = 1.5f;
+constexpr int kSoraFloatingMaxWidth = 750;
+constexpr float kSoraFloatingMinWidthFraction = 0.9f;
+constexpr int kSoraFloatingMinWidthCap = 992;  // 62rem at 16px.
+constexpr int kSoraFloatingMinBlockHeight = 333;
+// Space between the field's edges and the text.
+constexpr int kSoraFloatingInlineMargin = 12;
