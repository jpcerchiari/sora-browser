diff --git a/ui/webui/resources/cr_components/searchbox/searchbox_match.css b/ui/webui/resources/cr_components/searchbox/searchbox_match.css
index 2344ea9..9cee616 100644
--- a/ui/webui/resources/cr_components/searchbox/searchbox_match.css
+++ b/ui/webui/resources/cr_components/searchbox/searchbox_match.css
@@ -420,3 +420,71 @@
   font-size: 12px;
   line-height: 16px;
 }
+
+/* Sora: Zen's URL bar results rows (sora/zen-spec.md, section 4,
+ * "Resultados"), only in the omnibox popup; the colors come from
+ * omnibox_popup/app.css. The extra :host outranks the
+ * [is-top-chrome-searchbox_] rules above that fix the height of rows with
+ * chips. */
+:host-context(omnibox-popup-app):host .container:not(.actions) {
+  border-radius: 6px;
+  box-sizing: border-box;
+  height: auto;
+  margin-inline-end: 0;
+  min-height: 45px;
+  padding: 10px 8px;
+}
+
+:host-context(omnibox-popup-app) #text-container {
+  font-size: 14px;
+  font-weight: 500;
+}
+
+/* Sora: the favicon sits on a 4px-radius box, tinted like the row on hover
+ * and a white chip on the selected row. Only real favicons get the chip; the
+ * search and history glyphs turn white with the text. */
+:host-context(omnibox-popup-app) #icon {
+  border-radius: 4px;
+}
+
+:host-context(omnibox-popup-app) .container:not(.actions):hover #icon {
+  background-color: var(--sora-results-hover);
+}
+
+:host-context(omnibox-popup-app):host(:is(:focus-visible, [selected]))
+    #icon:is([favicon-image_]:not([favicon-image_=''])) {
+  background-color: var(--sora-results-favicon-selected);
+}
+
+/* Sora: the search engine chip (Tab to search): 12px, weight 600, padding
+ * 4 x 6px, radius 4px, 10% background and no border. */
+:host-context(omnibox-popup-app) #keyword {
+  background-color: var(--sora-results-chip);
+  border: none;
+  border-radius: 4px;
+  font-size: 12px;
+  font-weight: 600;
+  height: auto;
+  padding: 4px 6px;
+}
+
+:host-context(omnibox-popup-app):host(:is(:focus-visible, [selected])) #keyword {
+  background-color: var(--sora-results-chip-selected);
+}
+
+/* Sora: "Switch to this tab" and the other actions read as Zen's switch-tab
+ * label: no chip, weight 600, 70% opacity, full on the selected row. */
+:host-context(omnibox-popup-app) #action {
+  background-color: transparent;
+  border: none;
+  font-weight: 600;
+  opacity: 0.7;
+}
+
+:host-context(omnibox-popup-app):host(:is(:focus-visible, [selected])) #action {
+  opacity: 1;
+}
+
+:host-context(omnibox-popup-app):host :is(#keyword, #action):hover {
+  background-color: var(--color-searchbox-results-button-hover);
+}
