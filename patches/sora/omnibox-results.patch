--- a/chrome/browser/resources/omnibox_popup/app.css
+++ b/chrome/browser/resources/omnibox_popup/app.css
@@ -25,7 +25,70 @@
 }
 
 :host([has-visible-matches_]) .dropdownContainer {
-  padding-bottom: 10px;
+  /* Sora: the list's own 12px padding (below) replaces this. */
+  padding-bottom: 0;
+}
+
+/* Sora: Zen's URL bar results (sora/zen-spec.md, section 4, "Resultados").
+ * Only the classic popup (omnibox-popup-app) gets this look: the colors below
+ * cascade into cr-searchbox-dropdown and cr-searchbox-match, and the row
+ * layout lives in searchbox_match.css under :host-context(omnibox-popup-app),
+ * so the NTP realbox and the other popups keep Chromium's style. */
+:host {
+  /* --zen-color-contrast-70's base, --zen-branding-bg-reverse,
+   * --zen-urlbar-view-url-color and --zen-accent-button-background. */
+  --sora-results-contrast: black;
+  --sora-results-branding-reverse: #101010;
+  --sora-results-url: #4a4a4a;
+  --sora-results-accent:
+      oklch(from var(--color-sys-primary) clamp(0.35, l, 0.6) c h);
+
+  --sora-results-hover:
+      color-mix(in srgb, var(--sora-results-branding-reverse) 5%, transparent);
+  --sora-results-chip:
+      color-mix(in srgb, var(--sora-results-branding-reverse) 10%, transparent);
+  --sora-results-chip-selected:
+      color-mix(in srgb, var(--sora-results-branding-reverse) 20%, transparent);
+  --sora-results-favicon-selected: rgba(255, 255, 255, 0.9);
+
+  --color-searchbox-results-foreground:
+      color-mix(in srgb, var(--sora-results-contrast) 70%, transparent);
+  --color-searchbox-results-foreground-dimmed: var(--sora-results-url);
+  --color-searchbox-results-url: var(--sora-results-url);
+  --color-searchbox-results-background-hovered: var(--sora-results-hover);
+  --color-searchbox-results-background-selected:
+      color-mix(in srgb, var(--sora-results-accent) 60%, transparent);
+  --color-searchbox-results-foreground-selected: white;
+  --color-searchbox-results-url-selected: white;
+  --color-searchbox-results-dim-selected: white;
+  --color-searchbox-results-icon-selected: white;
+  --color-searchbox-results-action-chip-icon-selected: white;
+  /* Zen has no bar at the start of the selected row. */
+  --color-searchbox-results-focus-indicator: transparent;
+}
+
+@media (prefers-color-scheme: dark) {
+  :host {
+    --sora-results-contrast: white;
+    --sora-results-branding-reverse: #e2e2e2;
+    --sora-results-url: #aaaaaa;
+    --sora-results-accent:
+        oklch(from var(--color-sys-primary) clamp(0.55, l, 0.7) c h);
+  }
+}
+
+/* Sora: favicon box of 16px plus 4px of padding. */
+cr-searchbox-dropdown {
+  --cr-searchbox-icon-container-size: 24px;
+}
+
+/* Sora: at most 244px of rows inside 12px of padding; the rest scrolls
+ * without a scrollbar (app.ts keeps the selection in view). */
+cr-searchbox-dropdown::part(dropdown-content) {
+  max-height: 244px;
+  overflow-y: auto;
+  padding: 12px;
+  scrollbar-width: none;
 }
 
