+SkColor ZenDominantFromSystemAccent(SkColor system_accent, bool dark) {
+  const SoraAccentPalette& a = dark ? kAccentDark : kAccentLight;
+  const SkColor mixed =
+      ZenBlend(system_accent, a.toolbar_base, a.system_weight);
+  return ZenBlend(mixed, SK_ColorBLACK, a.darken_weight);
