+SkColor ZenPrimaryFromDominant(SkColor dominant, bool dark) {
+  dominant = SkColorSetA(dominant, SK_AlphaOPAQUE);
+  if (dark || (SkColorGetR(dominant) == SkColorGetG(dominant) &&
+               SkColorGetG(dominant) == SkColorGetB(dominant))) {
+    return dominant;
+  }
