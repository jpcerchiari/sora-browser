+  color_utils::SkColorToHSL(dominant, &hsl);
+  hsl.s = std::min(1.0, hsl.s + kAccentSaturationBoost);
+  hsl.l = hsl.l * kAccentLightnessKeep +
+          kAccentTargetLightness * (1.0 - kAccentLightnessKeep);
+  return color_utils::HSLToSkColor(hsl, SK_AlphaOPAQUE);
