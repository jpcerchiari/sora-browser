+  const SoraAccentPalette& a = dark ? kAccentDark : kAccentLight;
+  const auto [x, y, z] = gfx::SRGBToXYZD50(SkColorGetR(primary) / 255.0f,
+                                           SkColorGetG(primary) / 255.0f,
+                                           SkColorGetB(primary) / 255.0f);
+  auto [l, ok_a, ok_b] = gfx::XYZD50ToOklab(x, y, z);
+  // Changing only the lightness keeps chroma and hue, as in oklch().
+  l = std::clamp(l, a.button_min_lightness, a.button_max_lightness);
+  const auto [x2, y2, z2] =
+      gfx::OklabToXYZD50(l, ok_a, ok_b, /*gamut_map=*/true);
+  const auto [r, g, b] = gfx::XYZD50ToSRGB(x2, y2, z2);
+  const auto channel = [](float v) {
+    return base::ClampRound<U8CPU>(std::clamp(v, 0.0f, 1.0f) * 255.0f);
+  };
+  return SkColorSetRGB(channel(r), channel(g), channel(b));
+}
