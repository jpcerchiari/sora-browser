+// Sora: draws a fixed set of shadow values around the content, the way
+// ui::decoration::Shadow draws an elevation's (minus its elevation cap).
+class FixedShadowSource : public ui::decoration::DecorationSource {
+ public:
+  DECLARE_SAFE_CAST_TARGET()
+
+  explicit FixedShadowSource(gfx::ShadowValues shadows)
+      : shadows_(std::move(shadows)) {}
+  FixedShadowSource(const FixedShadowSource&) = delete;
+  FixedShadowSource& operator=(const FixedShadowSource&) = delete;
+  ~FixedShadowSource() override = default;
+
+  // ui::decoration::DecorationSource:
+  std::optional<Details> GetDetails(
+      const gfx::Rect& content_bounds,
+      const gfx::RoundedCornersF& rounded_corners) override {
+    const ui::decoration::ShadowDetails& details =
+        ui::decoration::ShadowDetails::Get(rounded_corners, shadows_);
+    // The ninebox needs the content to be at least as big as its corners.
+    if (content_bounds.width() < details.aperture_insets.width() ||
+        content_bounds.height() < details.aperture_insets.height()) {
+      return std::nullopt;
+    }
+    gfx::Rect occlusion_rect(content_bounds.size());
+    occlusion_rect.Inset(
+        ui::decoration::GetInsetsForRoundedCorners(rounded_corners));
+    return Details{
+        .appearance =
+            {
+                .nine_patch_image = details.nine_patch_image,
+                .aperture_insets = details.aperture_insets,
+                .margins = details.margins,
+            },
+        .occlusion_rect = occlusion_rect,
+    };
+  }
+
+ private:
+  const gfx::ShadowValues shadows_;
+};
+
+DEFINE_SAFE_CAST_TARGET(FixedShadowSource)
+
+}  // namespace
+
+// Sora: same as views::ViewShadow (puts `decoration` below the view's layer
+// and keeps it framing the view), but for any decoration, so that a fixed
+// shadow can be drawn as well as an elevation.
+class ShadowFrameView::DecorationShadow : public views::ViewObserver {
+ public:
+  DecorationShadow(views::View* view,
+                   std::unique_ptr<ui::Decoration> decoration)
+      : view_(view), decoration_(std::move(decoration)) {
+    if (!view_->layer()) {
+      view_->SetPaintToLayer();
+    }
+    view_->AddLayerToRegion(decoration_->layer(), views::LayerRegion::kBelow);
+    decoration_->SetContentBounds(view_->layer()->bounds());
+    view_observation_.Observe(view_);
+  }
+  DecorationShadow(const DecorationShadow&) = delete;
+  DecorationShadow& operator=(const DecorationShadow&) = delete;
+  ~DecorationShadow() override {
+    if (view_) {
+      OnViewIsDeleting(view_);
+    }
+  }
+
+  ui::Decoration* decoration() { return decoration_.get(); }
+
+  void SetRoundedCornerRadius(int corner_radius) {
+    SetRoundedCorners(gfx::RoundedCornersF(corner_radius));
+  }
+  void SetRoundedCorners(const gfx::RoundedCornersF& radii) {
+    decoration_->SetRoundedCorners(radii);
+  }
+
+ private:
+  // views::ViewObserver:
+  void OnViewLayerBoundsSet(views::View* view) override {
+    decoration_->SetContentBounds(view_->layer()->bounds());
+  }
+  void OnViewIsDeleting(views::View* view) override {
+    decoration_.reset();
+    view_observation_.Reset();
+    view_ = nullptr;
+  }
+
+  raw_ptr<views::View> view_;
+  std::unique_ptr<ui::Decoration> decoration_;
+  base::ScopedObservation<views::View, views::ViewObserver> view_observation_{
+      this};
+};
 
