+// Zen's blendColors(): `weight` of `a` and the rest of `b`, rounded per channel.
+SkColor ZenBlend(SkColor a, SkColor b, float weight) {
+  const auto mix = [weight](U8CPU x, U8CPU y) {
+    return base::ClampRound<U8CPU>(x * weight + y * (1.0f - weight));
+  };
+  return SkColorSetRGB(mix(SkColorGetR(a), SkColorGetR(b)),
+                       mix(SkColorGetG(a), SkColorGetG(b)),
+                       mix(SkColorGetB(a), SkColorGetB(b)));
+}
