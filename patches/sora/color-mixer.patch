+// Copyright 2026 The Sora Browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_COLOR_SORA_COLOR_MIXER_H_
+#define CHROME_BROWSER_UI_COLOR_SORA_COLOR_MIXER_H_
+
+namespace ui {
+class ColorProvider;
+struct ColorProviderKey;
+}  // namespace ui
+
+// Adds the Sora Browser surface colors (frame, toolbar, tabs, omnibox) to
+// `provider` with `key`. Must run after the native mixer and before custom
+// themes, so installed themes still win.
+void AddSoraColorMixer(ui::ColorProvider* provider,
+                       const ui::ColorProviderKey& key);
+
+#endif  // CHROME_BROWSER_UI_COLOR_SORA_COLOR_MIXER_H_
