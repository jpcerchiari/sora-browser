+    SetPaintTransparent(true);
+    SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    SetInsets(gfx::Insets::VH(0, kSoraNewTabRowPadding));
+    SetImageLabelSpacing(kSoraNewTabRowIconLabelSpacing);
+    label()->SetFontList(
+        gfx::FontList().DeriveWithSizeDelta(kSoraNewTabRowTitleSizeDelta));
+    // The row is see-through, so the label gets grayscale text on its own
+    // layer, as TabStripFlatEdgeButton::SetShouldShowLabel() does.
+    label()->SetPaintToLayer();
+    label()->layer()->SetFillsBoundsOpaquely(false);
+    label()->SetSkipSubpixelRenderingOpacityCheck(true);
+    label()->SetSubpixelRenderingEnabled(false);
+    // TabStripFlatEdgeButton only manages its label when SetShouldShowLabel()
+    // is on, so this text stays put. IDS_NEW_TAB is "New &tab": drop the
+    // mnemonic the same way the action's tooltip does.
+    SetText(BrowserActions::GetCleanTitleAndTooltipText(
+        l10n_util::GetStringUTF16(IDS_NEW_TAB)));
+  }
+  SoraNewTabRow(const SoraNewTabRow&) = delete;
+  SoraNewTabRow& operator=(const SoraNewTabRow&) = delete;
