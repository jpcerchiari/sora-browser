+    SetEnabledTextColors(ui::ColorVariant(SkColorSetA(
+        text_color, base::ClampRound<SkAlpha>(SkColorGetA(text_color) *
+                                              kSoraNewTabRowLabelOpacity))));
+  }
+
+ protected:
+  // views::Button:
+  void StateChanged(ButtonState old_state) override {
+    shared::NewTabButton::StateChanged(old_state);
+    const bool pressed = GetState() == STATE_PRESSED;
+    if (!layer() || pressed == (old_state == STATE_PRESSED)) {
