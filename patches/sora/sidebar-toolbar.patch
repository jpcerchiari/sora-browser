+void ToolbarView::UpdateSoraSidebarMode() {
+  const auto* controller =
+      tabs::VerticalTabStripStateController::From(browser_view_->browser());
+  const bool sidebar_mode = display_mode_ == DisplayMode::kNormal &&
+                            location_bar_view_ && controller &&
+                            controller->ShouldDisplayVerticalTabs() &&
+                            !controller->IsCollapsed();
+  if (sidebar_mode == sora_sidebar_mode_) {
+    return;
+  }
+  sora_sidebar_mode_ = sidebar_mode;
+
+  // In the sidebar the location bar gets its own row, so it gives up its width
+  // first and never pushes the buttons out of the flex layout.
+  if (sidebar_mode) {
+    if (const auto* flex =
+            location_bar_view_->GetProperty(views::kFlexBehaviorKey)) {
+      sora_saved_location_bar_flex_ = *flex;
+    }
+    location_bar_view_->SetProperty(
+        views::kFlexBehaviorKey,
+        views::FlexSpecification(views::LayoutOrientation::kHorizontal,
+                                 views::MinimumFlexSizeRule::kScaleToZero,
+                                 views::MaximumFlexSizeRule::kPreferred)
+            .WithOrder(std::numeric_limits<int>::max()));
+  } else if (sora_saved_location_bar_flex_) {
+    location_bar_view_->SetProperty(views::kFlexBehaviorKey,
+                                    *sora_saved_location_bar_flex_);
+    sora_saved_location_bar_flex_.reset();
+  }
+  InvalidateLayout();
+  PreferredSizeChanged();
+}
+
+void ToolbarView::LayoutSoraSidebarRows() {
+  gfx::Rect area = GetContentsBounds();
+  area.Inset(gfx::Insets::VH(0, kSoraSidebarPadding));
+
+  // Second row: the location bar, full width.
+  const int location_bar_height =
+      location_bar_view_->GetPreferredSize().height();
+  location_bar_view_->SetBounds(
+      area.x() + kSoraLocationBarMargin,
+      area.y() + kSoraButtonRowHeight +
+          (kSoraLocationRowHeight - location_bar_height) / 2,
+      area.width() - 2 * kSoraLocationBarMargin, location_bar_height);
+
+  // First row: the app menu and the other buttons at the leading edge,
+  // navigation at the trailing edge, as in Zen.
+  std::vector<views::View*> leading;
+  std::vector<views::View*> trailing;
+  for (views::View* child : children()) {
+    if (child == location_bar_view_ || !child->GetVisible()) {
+      continue;
+    }
+    const bool navigation = child == back_ || child == forward_ ||
+                            child == reload_ || child == home_;
+    (navigation ? trailing : leading).push_back(child);
+  }
+  std::stable_partition(
+      leading.begin(), leading.end(),
+      [this](views::View* view) { return view == app_menu_button_; });
+
+  const auto place = [&area](views::View* view, int x) {
+    const gfx::Size size = view->GetPreferredSize();
+    view->SetBounds(x, area.y() + (kSoraButtonRowHeight - size.height()) / 2,
+                    size.width(), size.height());
+    return size.width();
+  };
+  int right = area.right();
+  for (views::View* view : base::Reversed(trailing)) {
+    right -= view->GetPreferredSize().width();
+    place(view, right);
+    right -= kSoraButtonGap;
+  }
+  int x = area.x();
+  for (views::View* view : leading) {
+    if (x + view->GetPreferredSize().width() > right) {
+      view->SetBoundsRect(gfx::Rect());
+      continue;
+    }
+    x += place(view, x) + kSoraButtonGap;
+  }
 }
 
